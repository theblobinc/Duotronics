{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/proof_witness.schema.json",
  "title": "ProofWitness",
  "description": "Proof witness linking a claim to a Lean compiler witness and a named theorem artifact. Required for theorem/proof_verified promotion in Draft 5.2.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_witness_id",
    "claim_id",
    "theorem_name",
    "proof_artifact_ref",
    "lean_compiler_witness_id",
    "lean_compiler_result",
    "theorem_status",
    "source_hash_matches_claim",
    "no_sorry",
    "no_admit",
    "no_unapproved_axioms",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "proof_witness/v1"
    },
    "proof_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "theorem_name": {
      "type": "string",
      "minLength": 1
    },
    "proof_artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "lean_compiler_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "lean_compiler_result": {
      "enum": [
        "passed",
        "failed",
        "advisory_pass_lake_unavailable",
        "strict_fail_lake_unavailable",
        "failed_static_scan",
        "failed_lake_build"
      ]
    },
    "theorem_status": {
      "enum": [
        "proved",
        "failed",
        "sorry_stub",
        "axiom_dependent",
        "source_hash_mismatch"
      ]
    },
    "source_hash_matches_claim": {
      "type": "boolean"
    },
    "no_sorry": {
      "type": "boolean"
    },
    "no_admit": {
      "type": "boolean"
    },
    "no_unapproved_axioms": {
      "type": "boolean"
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "theorem_status": {
            "const": "proved"
          }
        }
      },
      "then": {
        "properties": {
          "lean_compiler_result": {
            "const": "passed"
          },
          "source_hash_matches_claim": {
            "const": true
          },
          "no_sorry": {
            "const": true
          },
          "no_admit": {
            "const": true
          },
          "no_unapproved_axioms": {
            "const": true
          }
        }
      }
    }
  ]
}
