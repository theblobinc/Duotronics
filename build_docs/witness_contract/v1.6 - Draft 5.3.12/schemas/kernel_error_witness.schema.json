{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/kernelErrorWitness.schema.json",
  "title": "KernelErrorWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kernel_error_witness_id",
    "task_id",
    "error_code",
    "severity",
    "message",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "kernel_error_witness/v1"
    },
    "kernel_error_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "error_code": {
      "enum": [
        "missing_witness",
        "authority_denied",
        "non_collapse_violation",
        "replay_assumption_missing",
        "indeterminate_result",
        "human_review_required",
        "schema_validation_failed",
        "resource_budget_exceeded",
        "canonical_rule_ambiguous",
        "capability_denied"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "denied_syscall": {
      "enum": [
        "observe",
        "compose",
        "infer",
        "verify",
        "replay",
        "delegate",
        "promote",
        "compute",
        "adjudicate",
        "rollback",
        "export",
        "resolve_rule",
        "read_memory",
        "write_observation",
        "promote_memory",
        "raise_error",
        null
      ]
    },
    "missing_witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "non_collapse_transition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation_required": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Typed evidence for refusal, denial, or escalation.",
  "allOf": [
    {
      "if": {
        "properties": {
          "error_code": {
            "const": "missing_witness"
          }
        }
      },
      "then": {
        "properties": {
          "missing_witness_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  ]
}
