{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_compile_handoff_v3.schema.json",
  "title": "Independently Reconstructable Lean Compile Handoff Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compiled_modules", "compilation_commands",
    "warnings_as_errors", "warning_as_error_cli_option",
    "command_reconstruction_policy", "lean_executable_path",
    "lean_executable_sha256", "working_directory",
    "compilation_environment_sha256",
    "binding_module_sha256", "binding_olean_path", "binding_olean_sha256",
    "artifacts", "artifact_count", "total_handoff_bytes",
    "maximum_artifact_bytes", "maximum_handoff_bytes"
  ],
  "properties": {
    "schema_version": {"const": "lean_compile_handoff/v3"},
    "compiled_modules": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {"role": {"const": "generated_binding"}},
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "role", "source_sha256", "olean_path", "olean_sha256"],
        "properties": {
          "module": {"type": "string", "pattern": "^(?:[A-Za-z_][A-Za-z0-9_']*[.])*[A-Za-z_][A-Za-z0-9_']*$"},
          "role": {"enum": ["submitted_source", "generated_binding"]},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "olean_path": {"$ref": "#/$defs/path"},
          "olean_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "compilation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "role", "argv_sha256"],
        "properties": {
          "module": {"type": "string", "pattern": "^(?:[A-Za-z_][A-Za-z0-9_']*[.])*[A-Za-z_][A-Za-z0-9_']*$"},
          "role": {"enum": ["submitted_source", "generated_binding"]},
          "argv_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "warnings_as_errors": {"const": true},
    "warning_as_error_cli_option": {"const": "-DwarningAsError=true"},
    "command_reconstruction_policy": {"const": "lean_compile_command_reconstruction/v1"},
    "lean_executable_path": {"type": "string", "pattern": "^/(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\).+/lean$"},
    "lean_executable_sha256": {"$ref": "#/$defs/sha256"},
    "working_directory": {"type": "string", "pattern": "^/(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\).+"},
    "compilation_environment_sha256": {"$ref": "#/$defs/sha256"},
    "binding_module_sha256": {"$ref": "#/$defs/sha256"},
    "binding_olean_path": {"$ref": "#/$defs/path"},
    "binding_olean_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "mode"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "mode": {"enum": ["0440", "0600", "0640", "0644"]}
        }
      }
    },
    "artifact_count": {"type": "integer", "minimum": 1},
    "total_handoff_bytes": {"type": "integer", "minimum": 1},
    "maximum_artifact_bytes": {"type": "integer", "minimum": 1},
    "maximum_handoff_bytes": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\).+[.]olean$"}
  }
}
