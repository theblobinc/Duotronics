{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/verifier_key_status_event_v2.schema.json",
  "title": "SignedVerifierKeyStatusEventV2",
  "type": "object", "additionalProperties": false,
  "required": ["key_status_event_id", "schema_version", "key_id", "status", "reason", "effective_at", "recorded_at", "policy_decision_id", "authorization_witness_id", "governance_key_id", "timestamp_source", "effective_time_witness_id", "signed_payload_sha256", "signature"],
  "properties": {
    "key_status_event_id": {"type": "string", "minLength": 1}, "schema_version": {"const": "verifier_key_status_event/v2"},
    "key_id": {"type": "string", "minLength": 1}, "status": {"enum": ["active", "revoked", "retired", "superseded"]},
    "replacement_key_id": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"},
    "policy_decision_id": {"type": "string", "minLength": 1}, "authorization_witness_id": {"type": "string", "minLength": 1},
    "governance_key_id": {"type": "string", "minLength": 1}, "signed_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp_source": {"enum": ["authority_service_clock", "trusted_time_witness"]}, "effective_time_witness_id": {"type": ["string", "null"]},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]}, "then": {"properties": {"replacement_key_id": {"type": "string", "minLength": 1}}}, "else": {"properties": {"replacement_key_id": {"type": "null"}}}},
    {"if": {"properties": {"timestamp_source": {"const": "authority_service_clock"}}, "required": ["timestamp_source"]}, "then": {"properties": {"effective_time_witness_id": {"type": "null"}}}, "else": {"properties": {"effective_time_witness_id": {"type": "string", "minLength": 1}}}}
  ]
}
