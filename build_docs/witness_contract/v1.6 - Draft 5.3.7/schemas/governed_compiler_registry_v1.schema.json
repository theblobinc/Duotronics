{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/governed_compiler_registry_v1.schema.json",
  "title": "GovernedCompilerRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "governance_key_id", "profiles", "created_at", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "governed_compiler_registry/v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "governance_key_id": {"type": "string", "minLength": 1},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "created_at": {"type": "string", "format": "date-time"},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler_profile_id", "toolchain", "image_reference", "execution_image_digest", "lake_executable_sha256", "lean_executable_sha256", "lean_stdlib_tree_sha256", "dependency_closure_sha256", "verifier_binary_sha256", "sandbox_policy_sha256", "authorized_axioms", "valid_from"],
      "properties": {
        "compiler_profile_id": {"type": "string", "minLength": 1},
        "toolchain": {"type": "string", "minLength": 1},
        "image_reference": {"type": "string", "minLength": 1},
        "execution_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "lake_executable_sha256": {"$ref": "#/$defs/sha256"},
        "lean_executable_sha256": {"$ref": "#/$defs/sha256"},
        "lean_stdlib_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_binary_sha256": {"$ref": "#/$defs/sha256"},
        "sandbox_policy_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_axioms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
