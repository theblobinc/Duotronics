{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/verifier_principal_v2.schema.json",
  "title": "VerifierPrincipalV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verifier_principal_id", "key_id", "signature_algorithm", "public_key_fingerprint_sha256", "status", "valid_from", "created_at"],
  "properties": {
    "schema_version": {"const": "verifier_principal/v2"},
    "verifier_principal_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256", "RSA-PSS-SHA256"]},
    "public_key_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["active", "revoked", "retired"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
