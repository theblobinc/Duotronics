{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/proof_policy_registry_v1.schema.json",
  "title": "Governance-Signed Proof Policy Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "governance_key_id", "decisions", "created_at", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "proof_policy_registry/v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "governance_key_id": {"type": "string", "minLength": 1},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "proof_policy_decision_v1.schema.json"}},
    "created_at": {"type": "string", "format": "date-time"},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 43}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
