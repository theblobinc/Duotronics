{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_verifier_result_v1.schema.json",
  "title": "LeanVerifierStructuredResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "request_sha256", "compiler_profile_id", "claim_content_sha256", "theorem_statement_sha256", "proof_artifact_sha256", "immutable_snapshot_sha256", "generated_witness_module_sha256", "lake_executable_sha256", "lean_executable_sha256", "lean_stdlib_tree_sha256", "dependency_closure_sha256", "execution_image_digest", "verifier_binary_sha256", "declaration_found", "declaration_type_matches", "axiom_dependencies", "build_from_source", "prebuilt_artifacts_used", "warnings_as_errors"],
  "properties": {
    "schema_version": {"const": "wc_lean_verifier_result/v1"},
    "status": {"enum": ["passed", "failed", "error"]},
    "request_sha256": {"$ref": "#/$defs/sha256"}, "compiler_profile_id": {"type": "string", "minLength": 1},
    "claim_content_sha256": {"$ref": "#/$defs/sha256"}, "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "proof_artifact_sha256": {"$ref": "#/$defs/sha256"}, "immutable_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "generated_witness_module_sha256": {"$ref": "#/$defs/sha256"}, "lake_executable_sha256": {"$ref": "#/$defs/sha256"},
    "lean_executable_sha256": {"$ref": "#/$defs/sha256"}, "lean_stdlib_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_closure_sha256": {"$ref": "#/$defs/sha256"}, "execution_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "verifier_binary_sha256": {"$ref": "#/$defs/sha256"}, "declaration_found": {"type": "boolean"},
    "declaration_type_matches": {"type": "boolean"}, "axiom_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "build_from_source": {"type": "boolean"}, "prebuilt_artifacts_used": {"type": "boolean"}, "warnings_as_errors": {"type": "boolean"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
