{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/theorem_promotion_gate_v2.schema.json",
  "title": "TheoremPromotionGateV2",
  "description": "Server-produced closure record. Draft 5.3.2 requires an effective verifier key and verified signatures for the compiler and proof witnesses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theorem_promotion_gate_id", "claim_id", "claim_content_sha256", "theorem_statement_sha256", "status_event_id", "proof_witness_id", "lean_compiler_witness_id", "non_collapse_transition_id", "policy_decision_id", "verifier_principal_id", "key_id", "allowed", "created_at"],
  "properties": {
    "schema_version": {"const": "theorem_promotion_gate/v2"},
    "theorem_promotion_gate_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_content_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "status_event_id": {"type": "string", "minLength": 1},
    "proof_witness_id": {"type": "string", "minLength": 1},
    "lean_compiler_witness_id": {"type": "string", "minLength": 1},
    "non_collapse_transition_id": {"type": "string", "minLength": 1},
    "policy_decision_id": {"type": "string", "minLength": 1},
    "verifier_principal_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "allowed": {"type": "boolean"},
    "rejection_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"allowed": {"const": true}}, "required": ["allowed"]},
      "then": {"properties": {"rejection_reason": {"type": "null"}}},
      "else": {"properties": {"rejection_reason": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
