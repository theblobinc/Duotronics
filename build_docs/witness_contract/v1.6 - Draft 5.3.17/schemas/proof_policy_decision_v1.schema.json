{
  "$defs": {
    "shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/proof_policy_decision_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_record_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "compiler_profile_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "governance_authority_id": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "const": "proof_check"
    },
    "policy_decision_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "resource_permissions": {
      "additionalProperties": false,
      "properties": {
        "maximum_source_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "maximum_timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maximum_timeout_seconds",
        "maximum_source_bytes"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "proof_policy_decision/v1"
    },
    "source_bundle_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired",
        "superseded"
      ]
    },
    "subject_id": {
      "minLength": 1,
      "type": "string"
    },
    "supersedes_policy_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "format": "date-time",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "policy_decision_id",
    "canonical_record_shake256_512",
    "status",
    "subject_id",
    "operation",
    "compiler_profile_ids",
    "source_bundle_ids",
    "resource_permissions",
    "valid_from",
    "valid_until",
    "supersedes_policy_decision_id",
    "governance_authority_id",
    "created_at"
  ],
  "title": "Immutable Proof Policy Decision v1",
  "type": "object"
}
