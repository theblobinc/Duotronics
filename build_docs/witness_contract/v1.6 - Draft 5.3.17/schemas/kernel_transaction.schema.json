{
  "$id": "https://duotronics.local/schemas/kernelTransaction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        }
      },
      "then": {
        "properties": {
          "committed_at": {
            "format": "date-time",
            "type": "string"
          },
          "emitted_witness_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "persisted_witness_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "committed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "aborted",
              "rolled_back"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "kernel_error_witness_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kernel_error_witness_id"
        ]
      }
    }
  ],
  "description": "Atomic evidence transaction: no witness, no commit.",
  "properties": {
    "committed_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "emitted_witness_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kernel_transaction_id": {
      "minLength": 1,
      "type": "string"
    },
    "non_collapse_checked": {
      "const": true,
      "type": "boolean"
    },
    "persisted_witness_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "precondition_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "kernel_transaction/v1"
    },
    "status": {
      "enum": [
        "open",
        "committed",
        "aborted",
        "rolled_back"
      ]
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "transaction_kind": {
      "enum": [
        "evidence",
        "memory",
        "promotion",
        "replay",
        "resolution",
        "adjudication",
        "rollback"
      ]
    }
  },
  "required": [
    "schema_version",
    "kernel_transaction_id",
    "task_id",
    "transaction_kind",
    "status",
    "precondition_refs",
    "emitted_witness_refs",
    "persisted_witness_refs",
    "non_collapse_checked",
    "policy_decision_id",
    "created_at"
  ],
  "title": "KernelTransaction",
  "type": "object"
}
