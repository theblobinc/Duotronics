{
  "$id": "https://duotronics.local/schemas/authority_supersession_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "effective_time_witness_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "timestamp_source": {
            "const": "authority_service_clock"
          }
        },
        "required": [
          "timestamp_source"
        ]
      },
      "then": {
        "properties": {
          "effective_time_witness_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "authorization_witness_id": {
      "minLength": 1,
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "type": "string"
    },
    "effective_time_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "governance_key_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "record_type": {
      "enum": [
        "verifier_principal",
        "verifier_key",
        "compiler_witness",
        "proof_witness",
        "promotion_gate"
      ]
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "replacement_record_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "authority_supersession/v2"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "pattern": "^[A-Za-z0-9_-]{6170}$",
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "pattern": "^[a-f0-9]{128}$",
      "type": "string"
    },
    "superseded_record_id": {
      "minLength": 1,
      "type": "string"
    },
    "supersession_id": {
      "minLength": 1,
      "type": "string"
    },
    "timestamp_source": {
      "enum": [
        "authority_service_clock",
        "trusted_time_witness"
      ]
    }
  },
  "required": [
    "supersession_id",
    "schema_version",
    "record_type",
    "superseded_record_id",
    "replacement_record_id",
    "reason",
    "effective_at",
    "recorded_at",
    "policy_decision_id",
    "authorization_witness_id",
    "governance_key_id",
    "timestamp_source",
    "effective_time_witness_id",
    "signed_payload_shake256_512",
    "signature"
  ],
  "title": "SignedAuthoritySupersessionV2",
  "type": "object"
}
