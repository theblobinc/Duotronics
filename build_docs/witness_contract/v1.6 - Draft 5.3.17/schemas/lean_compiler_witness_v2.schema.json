{
  "$defs": {
    "shake256_512": {
      "pattern": "^[a-f0-9]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/lean_compiler_witness_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "passed"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "axiom_inspection_complete": {
            "const": true
          },
          "clean_source_build": {
            "const": true
          },
          "contains_admit": {
            "const": false
          },
          "contains_sorry": {
            "const": false
          },
          "hermetic_environment": {
            "const": true
          },
          "network_disabled": {
            "const": true
          },
          "prebuilt_artifacts_rejected": {
            "const": true
          },
          "resource_limits_enforced": {
            "const": true
          },
          "snapshot_verified_immutable": {
            "const": true
          },
          "statement_binding_confirmed": {
            "const": true
          },
          "structured_inspection_complete": {
            "const": true
          },
          "theorem_status": {
            "const": "proved"
          },
          "unapproved_axiom_count": {
            "const": 0
          },
          "warnings_as_errors": {
            "const": true
          }
        }
      }
    }
  ],
  "description": "Server-produced Draft 5.3.3 witness for a governed, hermetic, clean-source Lean verification with structured declaration/type/axiom inspection.",
  "properties": {
    "axiom_dependencies": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "axiom_inspection_complete": {
      "type": "boolean"
    },
    "build_output_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "claim_content_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "claim_id": {
      "minLength": 1,
      "type": "string"
    },
    "clean_source_build": {
      "type": "boolean"
    },
    "command": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "compiler_executable_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "compiler_profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "compiler_registry_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "contains_admit": {
      "type": "boolean"
    },
    "contains_sorry": {
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "dependency_closure_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "exact_build_target": {
      "pattern": "^\\.witness_authority/Check_[a-f0-9]{32}\\.lean$",
      "type": "string"
    },
    "execution_image_digest": {
      "pattern": "^shake256-512:[a-f0-9]{128}$",
      "type": "string"
    },
    "execution_mode": {
      "const": "strict"
    },
    "generated_witness_module_path": {
      "pattern": "^\\.witness_authority/Check_[a-f0-9]{32}\\.lean$",
      "type": "string"
    },
    "generated_witness_module_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "hermetic_environment": {
      "type": "boolean"
    },
    "immutable_snapshot_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "key_id": {
      "minLength": 1,
      "type": "string"
    },
    "lake_executable_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "lakefile_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "lean_compiler_witness_id": {
      "pattern": "^lean:[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "lean_executable_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "lean_stdlib_tree_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "network_disabled": {
      "type": "boolean"
    },
    "original_source_tree_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "prebuilt_artifacts_rejected": {
      "type": "boolean"
    },
    "proof_artifact_relative_path": {
      "minLength": 1,
      "type": "string"
    },
    "proof_artifact_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "proof_module": {
      "minLength": 1,
      "type": "string"
    },
    "resource_limits_enforced": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "toolchain_unavailable",
        "failed_static_scan",
        "failed_lake_build",
        "signature_failed"
      ]
    },
    "sandbox_policy_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "schema_version": {
      "const": "lean_compiler_witness/v2"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "pattern": "^[A-Za-z0-9_-]{6170}$",
      "type": "string"
    },
    "signature_algorithm": {
      "const": "ML-DSA-87"
    },
    "signed_payload_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "snapshot_verified_immutable": {
      "type": "boolean"
    },
    "source_tree_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "statement_binding_confirmed": {
      "type": "boolean"
    },
    "structured_inspection_complete": {
      "type": "boolean"
    },
    "structured_result_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "theorem_name": {
      "minLength": 1,
      "type": "string"
    },
    "theorem_statement_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "theorem_status": {
      "enum": [
        "proved",
        "failed",
        "sorry_stub",
        "axiom_dependent",
        "source_hash_mismatch"
      ]
    },
    "toolchain": {
      "minLength": 1,
      "type": "string"
    },
    "trusted_timestamp_source": {
      "minLength": 1,
      "type": "string"
    },
    "unapproved_axiom_count": {
      "minimum": 0,
      "type": "integer"
    },
    "verifier_binary_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "verifier_principal_id": {
      "minLength": 1,
      "type": "string"
    },
    "warnings_as_errors": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "lean_compiler_witness_id",
    "claim_id",
    "claim_content_shake256_512",
    "theorem_statement_shake256_512",
    "proof_artifact_shake256_512",
    "proof_artifact_relative_path",
    "proof_module",
    "source_tree_shake256_512",
    "original_source_tree_shake256_512",
    "immutable_snapshot_shake256_512",
    "lakefile_shake256_512",
    "generated_witness_module_shake256_512",
    "generated_witness_module_path",
    "exact_build_target",
    "compiler_profile_id",
    "compiler_registry_shake256_512",
    "lake_executable_shake256_512",
    "lean_executable_shake256_512",
    "lean_stdlib_tree_shake256_512",
    "dependency_closure_shake256_512",
    "execution_image_digest",
    "sandbox_policy_shake256_512",
    "verifier_binary_shake256_512",
    "compiler_executable_shake256_512",
    "structured_result_shake256_512",
    "build_output_shake256_512",
    "toolchain",
    "command",
    "execution_mode",
    "result",
    "contains_sorry",
    "contains_admit",
    "unapproved_axiom_count",
    "axiom_dependencies",
    "axiom_inspection_complete",
    "statement_binding_confirmed",
    "warnings_as_errors",
    "snapshot_verified_immutable",
    "clean_source_build",
    "prebuilt_artifacts_rejected",
    "hermetic_environment",
    "network_disabled",
    "resource_limits_enforced",
    "structured_inspection_complete",
    "theorem_name",
    "theorem_status",
    "verifier_principal_id",
    "key_id",
    "signature_algorithm",
    "trusted_timestamp_source",
    "signed_payload_shake256_512",
    "signature",
    "created_at"
  ],
  "title": "LeanCompilerWitnessV2Draft533",
  "type": "object"
}
