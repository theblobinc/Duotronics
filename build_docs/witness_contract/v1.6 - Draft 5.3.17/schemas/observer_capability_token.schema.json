{
  "$id": "https://duotronics.local/schemas/observerCapabilityToken.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "revoked": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "revocation_reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "revocation_reason"
        ]
      }
    }
  ],
  "description": "Bounded token authorizing a logical observer to invoke kernel syscalls.",
  "properties": {
    "authority_scopes": {
      "items": {
        "enum": [
          "none",
          "diagnostic",
          "local_session",
          "tenant",
          "repo",
          "service",
          "cluster",
          "system",
          "release",
          "mathematical_claim",
          "nla_training",
          "policy",
          "memory_write",
          "model_promotion",
          "truth_observer"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "capabilities": {
      "items": {
        "enum": [
          "observe",
          "compose",
          "infer",
          "verify",
          "replay",
          "delegate",
          "promote",
          "compute",
          "adjudicate",
          "rollback",
          "export",
          "resolve_rule",
          "read_memory",
          "write_observation",
          "promote_memory",
          "raise_error"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "capability_token_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "delegation_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "force_limits": {
      "items": {
        "enum": [
          "observe",
          "propose",
          "assert",
          "defer",
          "veto",
          "delegate",
          "replay_verify"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "non_collapse_checked": {
      "const": true,
      "type": "boolean"
    },
    "observer_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "resource_budget_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "revocation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked": {
      "type": "boolean"
    },
    "runtime_modes": {
      "items": {
        "enum": [
          "observe",
          "test",
          "simulation",
          "shadow",
          "audit",
          "migration",
          "release_candidate",
          "production",
          "rollback"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "observer_capability_token/v1"
    },
    "valid_from": {
      "format": "date-time",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability_token_id",
    "observer_id",
    "capabilities",
    "authority_scopes",
    "runtime_modes",
    "force_limits",
    "valid_from",
    "valid_until",
    "policy_decision_id",
    "non_collapse_checked",
    "revoked",
    "created_at"
  ],
  "title": "ObserverCapabilityToken",
  "type": "object"
}
