{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_negative_evidence_witness.schema.json",
  "title": "BayesianNegativeEvidenceWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "negative_evidence_witness_id",
    "model_id",
    "evidence_ref",
    "evidence_kind",
    "handling_policy",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_negative_evidence_witness/v1"
    },
    "negative_evidence_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "negative_evidence",
        "missing_data",
        "censored_observation",
        "not_observed",
        "unknown_rejected"
      ]
    },
    "handling_policy": {
      "enum": [
        "explicit_absence_model",
        "missing_at_random_assumption",
        "missing_not_at_random_assumption",
        "likelihood_mask",
        "reject_update"
      ]
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}