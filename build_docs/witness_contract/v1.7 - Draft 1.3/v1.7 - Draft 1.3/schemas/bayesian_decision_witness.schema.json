{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_decision_witness.schema.json",
  "title": "BayesianDecisionWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_witness_id",
    "posterior_id",
    "decision_id",
    "decision_rule",
    "utility_or_loss_model",
    "policy_decision_required",
    "policy_decision_id",
    "model_id",
    "non_collapse_transition_id",
    "decision_authority",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_decision_witness/v1"
    },
    "decision_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "posterior_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_rule": {
      "enum": [
        "maximum_posterior",
        "minimum_expected_loss",
        "maximum_expected_utility",
        "abstain_under_uncertainty",
        "human_review"
      ]
    },
    "utility_or_loss_model": {
      "type": "object"
    },
    "expected_values": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_decision_required": {
      "type": "boolean"
    },
    "policy_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_authority": {
      "enum": [
        "decision_support",
        "policy_approved",
        "human_review_required",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "loss_matrix_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "abstention_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "human_review_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
