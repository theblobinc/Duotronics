{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_prior.schema.json",
  "title": "BayesianPrior",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prior_id",
    "model_id",
    "hypothesis_distribution",
    "normalization_status",
    "provenance_refs",
    "epistemic_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_prior/v1"
    },
    "prior_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_distribution": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "probability"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "support_ref": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "normalization_status": {
      "enum": [
        "normalized",
        "unnormalized_rejected",
        "approximate_declared"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epistemic_status": {
      "enum": [
        "candidate",
        "computed",
        "attested",
        "policy_bounded"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
