{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/kernelTransaction.schema.json",
  "title": "KernelTransaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kernel_transaction_id",
    "task_id",
    "transaction_kind",
    "status",
    "precondition_refs",
    "emitted_witness_refs",
    "persisted_witness_refs",
    "non_collapse_checked",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "kernel_transaction/v1"
    },
    "kernel_transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_kind": {
      "enum": [
        "evidence",
        "memory",
        "promotion",
        "replay",
        "resolution",
        "adjudication",
        "rollback"
      ]
    },
    "status": {
      "enum": [
        "open",
        "committed",
        "aborted",
        "rolled_back"
      ]
    },
    "precondition_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "emitted_witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "persisted_witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "non_collapse_checked": {
      "type": "boolean",
      "const": true
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "committed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "description": "Atomic evidence transaction: no witness, no commit.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        }
      },
      "then": {
        "required": [
          "committed_at"
        ],
        "properties": {
          "emitted_witness_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "persisted_witness_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "committed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "aborted",
              "rolled_back"
            ]
          }
        }
      },
      "then": {
        "required": [
          "kernel_error_witness_id"
        ],
        "properties": {
          "kernel_error_witness_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
