{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/theorem_promotion_gate.schema.json",
  "title": "TheoremPromotionGate",
  "description": "Gate object binding claim status promotion to proof witness, Lean compiler witness, non-collapse transition, and policy decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "theorem_promotion_gate_id",
    "claim_id",
    "claim_status_transition_id",
    "proof_witness_id",
    "lean_compiler_witness_id",
    "non_collapse_transition_id",
    "policy_decision_id",
    "allowed",
    "source_hash_matches_claim",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "theorem_promotion_gate/v1"
    },
    "theorem_promotion_gate_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_status_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "proof_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "lean_compiler_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed": {
      "type": "boolean"
    },
    "source_hash_matches_claim": {
      "type": "boolean"
    },
    "rejection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "source_hash_matches_claim": {
            "const": true
          },
          "rejection_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
