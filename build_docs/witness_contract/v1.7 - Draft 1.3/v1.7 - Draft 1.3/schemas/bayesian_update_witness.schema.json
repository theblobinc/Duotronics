{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_update_witness.schema.json",
  "title": "BayesianUpdateWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "update_witness_id",
    "model_id",
    "prior_id",
    "likelihood_id",
    "observation_evidence_ref",
    "posterior_id",
    "update_method",
    "normalization_constant",
    "approximation_used",
    "non_collapse_transition_id",
    "policy_decision_id",
    "created_at",
    "replay_grammar_ref",
    "reference_algorithm_id"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_update_witness/v1"
    },
    "update_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "prior_id": {
      "type": "string",
      "minLength": 1
    },
    "likelihood_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "posterior_id": {
      "type": "string",
      "minLength": 1
    },
    "update_method": {
      "enum": [
        "exact_discrete_bayes",
        "log_space_discrete_bayes",
        "conjugate_closed_form",
        "graphical_belief_propagation",
        "hierarchical_update",
        "approximate_monte_carlo",
        "external_verified"
      ]
    },
    "normalization_constant": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "approximation_used": {
      "type": "boolean"
    },
    "approximation_error_bound": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "replay_grammar_ref": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reference_algorithm_id": {
      "type": "string",
      "minLength": 1
    },
    "approximation_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "negative_or_missing_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
