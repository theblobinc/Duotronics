{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_presentation_transition_witness.schema.json",
  "title": "KnotPresentationTransitionWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "presentation_transition_witness_id",
    "source_object_ref",
    "target_object_ref",
    "transition_kind",
    "transition_witness_ref",
    "transition_status",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_presentation_transition_witness/v1"
    },
    "presentation_transition_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "source_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "transition_kind": {
      "enum": [
        "reidemeister_move",
        "reidemeister_trace",
        "braid_relation",
        "markov_move",
        "canonicalization",
        "proof_backed_equivalence"
      ]
    },
    "transition_witness_ref": {
      "type": "string",
      "minLength": 1
    },
    "transition_status": {
      "enum": [
        "candidate",
        "checked",
        "replayed",
        "proof_verified",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}