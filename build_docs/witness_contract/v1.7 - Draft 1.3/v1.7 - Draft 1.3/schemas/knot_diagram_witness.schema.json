{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_diagram_witness.schema.json",
  "title": "KnotDiagramWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_witness_id",
    "diagram_id",
    "encoding_type",
    "encoding_payload",
    "component_count",
    "orientation_policy",
    "canonicalization_status",
    "claim_status",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_diagram_witness/v1"
    },
    "diagram_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "encoding_type": {
      "enum": [
        "planar_diagram",
        "gauss_code",
        "dowker_thistlethwaite",
        "grid_diagram",
        "braid_closure",
        "implementation_defined"
      ]
    },
    "encoding_payload": {
      "type": "object"
    },
    "component_count": {
      "type": "integer",
      "minimum": 1
    },
    "crossing_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "orientation_policy": {
      "enum": [
        "oriented",
        "unoriented",
        "mixed",
        "unknown_rejected"
      ]
    },
    "mirror_policy": {
      "enum": [
        "distinguish_mirror",
        "identify_mirror",
        "unknown_rejected"
      ]
    },
    "canonical_form_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonicalization_status": {
      "enum": [
        "not_canonicalized",
        "canonicalized",
        "candidate",
        "rejected"
      ]
    },
    "claim_status": {
      "enum": [
        "candidate",
        "computed",
        "verified",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "canonicalization_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalization_convention_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "planar_diagram_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pd_code"
      ],
      "properties": {
        "pd_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "encoding_note": {
          "type": "string"
        }
      }
    },
    "gauss_code_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gauss_word"
      ],
      "properties": {
        "gauss_word": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "sign"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "integer",
                "minimum": 1
              },
              "sign": {
                "enum": [
                  "+",
                  "-"
                ]
              },
              "orientation": {
                "enum": [
                  "over",
                  "under",
                  "unknown"
                ]
              }
            }
          }
        },
        "encoding_note": {
          "type": "string"
        }
      }
    },
    "dowker_thistlethwaite_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dt_code",
        "signed"
      ],
      "properties": {
        "dt_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "signed": {
          "type": "boolean"
        },
        "encoding_note": {
          "type": "string"
        }
      }
    },
    "grid_diagram_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_size",
        "x_positions",
        "o_positions"
      ],
      "properties": {
        "grid_size": {
          "type": "integer",
          "minimum": 2
        },
        "x_positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "o_positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "encoding_note": {
          "type": "string"
        }
      }
    },
    "braid_closure_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strand_count",
        "generator_sequence",
        "closure_convention"
      ],
      "properties": {
        "strand_count": {
          "type": "integer",
          "minimum": 2
        },
        "generator_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "exponent"
            ],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "exponent": {
                "type": "integer",
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        "closure_convention": {
          "enum": [
            "standard_closure",
            "plat_closure"
          ]
        },
        "encoding_note": {
          "type": "string"
        }
      }
    },
    "implementation_defined_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_schema_ref",
        "payload_hash"
      ],
      "properties": {
        "payload_schema_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload_hash": {
          "type": "string",
          "minLength": 1
        },
        "encoding_note": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "planar_diagram"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/planar_diagram_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "gauss_code"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/gauss_code_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "dowker_thistlethwaite"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/dowker_thistlethwaite_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "grid_diagram"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/grid_diagram_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "braid_closure"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/braid_closure_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "encoding_type": {
            "const": "implementation_defined"
          }
        }
      },
      "then": {
        "properties": {
          "encoding_payload": {
            "$ref": "#/$defs/implementation_defined_payload"
          }
        }
      }
    }
  ]
}
