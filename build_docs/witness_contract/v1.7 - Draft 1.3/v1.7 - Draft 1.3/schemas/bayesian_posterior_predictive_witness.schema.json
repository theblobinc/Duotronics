{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_posterior_predictive_witness.schema.json",
  "title": "BayesianPosteriorPredictiveWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "posterior_predictive_witness_id",
    "model_id",
    "posterior_id",
    "predictive_distribution",
    "reference_algorithm_id",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_posterior_predictive_witness/v1"
    },
    "posterior_predictive_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "posterior_id": {
      "type": "string",
      "minLength": 1
    },
    "predictive_distribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "outcome_id",
          "probability"
        ],
        "additionalProperties": false,
        "properties": {
          "outcome_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "reference_algorithm_id": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}