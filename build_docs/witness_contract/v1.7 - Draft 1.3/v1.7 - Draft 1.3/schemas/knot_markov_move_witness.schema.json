{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_markov_move_witness.schema.json",
  "title": "KnotMarkovMoveWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "markov_move_witness_id",
    "source_braid_id",
    "target_braid_id",
    "markov_move_type",
    "checked",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_markov_move_witness/v1"
    },
    "markov_move_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "source_braid_id": {
      "type": "string",
      "minLength": 1
    },
    "target_braid_id": {
      "type": "string",
      "minLength": 1
    },
    "markov_move_type": {
      "enum": [
        "conjugation",
        "stabilization",
        "destabilization"
      ]
    },
    "checked": {
      "type": "boolean"
    },
    "checker_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}