{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_compiler_witness_v2.schema.json",
  "title": "LeanCompilerWitnessV2",
  "description": "Server-produced signed record of one strict compiler execution over content-bound claim and proof bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lean_compiler_witness_id", "claim_id", "claim_content_sha256", "theorem_statement_sha256", "proof_artifact_sha256", "source_tree_sha256", "lakefile_sha256", "build_output_sha256", "toolchain", "command", "execution_mode", "result", "contains_sorry", "contains_admit", "unapproved_axiom_count", "theorem_name", "theorem_status", "verifier_principal_id", "key_id", "signature_algorithm", "signed_payload_sha256", "signature", "created_at"],
  "properties": {
    "schema_version": {"const": "lean_compiler_witness/v2"},
    "lean_compiler_witness_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_content_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "proof_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "lakefile_sha256": {"$ref": "#/$defs/sha256"},
    "build_output_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain": {"type": "string", "minLength": 1},
    "command": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "execution_mode": {"const": "strict"},
    "result": {"enum": ["passed", "failed", "toolchain_unavailable", "failed_static_scan", "failed_lake_build", "signature_failed"]},
    "contains_sorry": {"type": "boolean"},
    "contains_admit": {"type": "boolean"},
    "unapproved_axiom_count": {"type": "integer", "minimum": 0},
    "theorem_name": {"type": "string", "minLength": 1},
    "theorem_status": {"enum": ["proved", "failed", "sorry_stub", "axiom_dependent", "source_hash_mismatch"]},
    "verifier_principal_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"enum": ["Ed25519", "ECDSA-P256-SHA256", "RSA-PSS-SHA256"]},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "passed"}}, "required": ["result"]},
      "then": {"properties": {"contains_sorry": {"const": false}, "contains_admit": {"const": false}, "unapproved_axiom_count": {"const": 0}, "theorem_status": {"const": "proved"}}}
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
