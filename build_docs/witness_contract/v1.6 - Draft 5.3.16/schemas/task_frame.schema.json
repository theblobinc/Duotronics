{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/taskFrame.schema.json",
  "title": "TaskFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_frame_id",
    "task_id",
    "step_index",
    "call_stack",
    "deterministic",
    "hidden_state_allowed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "task_frame/v1"
    },
    "task_frame_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "call_stack": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "local_bindings": {
      "type": "object",
      "additionalProperties": true
    },
    "deterministic": {
      "type": "boolean",
      "const": true
    },
    "hidden_state_allowed": {
      "type": "boolean",
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Replayable task frame. Hidden state is forbidden."
}
