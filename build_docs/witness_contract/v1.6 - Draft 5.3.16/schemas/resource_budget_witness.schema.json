{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/resourceBudgetWitness.schema.json",
  "title": "ResourceBudgetWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_budget_id",
    "scope_ref",
    "max_steps",
    "max_recursion_depth",
    "max_memory_bytes",
    "network_allowed",
    "randomness_allowed",
    "wall_clock_allowed",
    "mutation_allowed",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "resource_budget_witness/v1"
    },
    "resource_budget_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "max_recursion_depth": {
      "type": "integer",
      "minimum": 0
    },
    "max_time_budget_ms": {
      "type": "integer",
      "minimum": 1
    },
    "max_memory_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    },
    "randomness_allowed": {
      "type": "boolean",
      "const": false
    },
    "wall_clock_allowed": {
      "type": "boolean",
      "const": false
    },
    "mutation_allowed": {
      "type": "boolean"
    },
    "mutation_requires_transaction": {
      "type": "boolean",
      "const": true
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Resource and safety budget for deterministic observer execution."
}
