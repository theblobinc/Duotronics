{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/non_collapse_transition.schema.json",
  "title": "NonCollapseTransition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "source_state_id",
    "target_state_id",
    "source_primitive_category",
    "target_primitive_category",
    "source_state_kind",
    "target_state_kind",
    "transition_kind",
    "collapse_status",
    "transition_status",
    "policy_decision_id",
    "forbidden_without_external_witness",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "non_collapse_transition/v1"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "source_state_id": {
      "type": "string",
      "minLength": 1
    },
    "target_state_id": {
      "type": "string",
      "minLength": 1
    },
    "source_primitive_category": {
      "enum": [
        "zero",
        "absence",
        "unknown",
        "invalid",
        "empty",
        "null",
        "computational_evidence",
        "theorem",
        "conjectural",
        "self_trained",
        "authoritative",
        "audit_only",
        "active",
        "observation",
        "proof",
        "explanation",
        "fact",
        "policy_approval",
        "human_attestation",
        "synthetic_witness",
        "activation_witness",
        "probabilistic_prior",
        "probabilistic_likelihood",
        "probabilistic_posterior",
        "bayesian_decision_support",
        "bayesian_calibration_evidence",
        "knot_diagram_presentation",
        "knot_braid_presentation",
        "knot_reidemeister_trace",
        "knot_invariant_evidence",
        "knot_canonical_form",
        "knot_equivalence_claim"
      ]
    },
    "target_primitive_category": {
      "enum": [
        "zero",
        "absence",
        "unknown",
        "invalid",
        "empty",
        "null",
        "computational_evidence",
        "theorem",
        "conjectural",
        "self_trained",
        "authoritative",
        "audit_only",
        "active",
        "observation",
        "proof",
        "explanation",
        "fact",
        "policy_approval",
        "human_attestation",
        "synthetic_witness",
        "activation_witness",
        "probabilistic_prior",
        "probabilistic_likelihood",
        "probabilistic_posterior",
        "bayesian_decision_support",
        "bayesian_calibration_evidence",
        "knot_diagram_presentation",
        "knot_braid_presentation",
        "knot_reidemeister_trace",
        "knot_invariant_evidence",
        "knot_canonical_form",
        "knot_equivalence_claim"
      ]
    },
    "source_state_kind": {
      "enum": [
        "value_state",
        "epistemic_state",
        "authority_state",
        "runtime_state",
        "claim_state",
        "model_state",
        "replay_state"
      ]
    },
    "target_state_kind": {
      "enum": [
        "value_state",
        "epistemic_state",
        "authority_state",
        "runtime_state",
        "claim_state",
        "model_state",
        "replay_state"
      ]
    },
    "transition_kind": {
      "enum": [
        "identity",
        "measurement",
        "observation",
        "promotion",
        "demotion",
        "proof_upgrade",
        "replay_verification",
        "authority_transfer",
        "policy_projection",
        "runtime_projection",
        "invalid_attempt",
        "bayesian_update",
        "bayesian_decision_projection",
        "bayesian_calibration_projection",
        "knot_presentation_transform",
        "knot_invariant_computation",
        "knot_canonicalization",
        "knot_equivalence_assertion"
      ]
    },
    "collapse_status": {
      "enum": [
        "not_collapsed",
        "collapse_denied",
        "transition_requires_witness",
        "transition_witnessed",
        "transition_allowed",
        "transition_forbidden"
      ]
    },
    "transition_status": {
      "enum": [
        "allowed",
        "denied",
        "escalated",
        "requires_external_witness",
        "requires_proof_witness"
      ]
    },
    "external_witness_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_witness_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "forbidden_without_external_witness": {
      "type": "boolean",
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transition_kind": {
            "const": "proof_upgrade"
          }
        }
      },
      "then": {
        "required": [
          "proof_witness_ref"
        ],
        "properties": {
          "transition_status": {
            "enum": [
              "allowed",
              "requires_proof_witness",
              "denied"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition_kind": {
            "enum": [
              "promotion",
              "authority_transfer"
            ]
          }
        }
      },
      "then": {
        "required": [
          "external_witness_ref"
        ],
        "properties": {
          "transition_status": {
            "enum": [
              "allowed",
              "requires_external_witness",
              "denied",
              "escalated"
            ]
          }
        }
      }
    }
  ]
}
