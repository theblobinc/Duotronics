{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_diagram_witness.schema.json",
  "title": "KnotDiagramWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_witness_id",
    "diagram_id",
    "encoding_type",
    "encoding_payload",
    "component_count",
    "orientation_policy",
    "canonicalization_status",
    "claim_status",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_diagram_witness/v1"
    },
    "diagram_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "encoding_type": {
      "enum": [
        "planar_diagram",
        "gauss_code",
        "dowker_thistlethwaite",
        "grid_diagram",
        "braid_closure",
        "implementation_defined"
      ]
    },
    "encoding_payload": {
      "type": "object"
    },
    "component_count": {
      "type": "integer",
      "minimum": 1
    },
    "crossing_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "orientation_policy": {
      "enum": [
        "oriented",
        "unoriented",
        "mixed",
        "unknown_rejected"
      ]
    },
    "mirror_policy": {
      "enum": [
        "distinguish_mirror",
        "identify_mirror",
        "unknown_rejected"
      ]
    },
    "canonical_form_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonicalization_status": {
      "enum": [
        "not_canonicalized",
        "canonicalized",
        "candidate",
        "rejected"
      ]
    },
    "claim_status": {
      "enum": [
        "candidate",
        "computed",
        "verified",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "canonicalization_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalization_convention_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
