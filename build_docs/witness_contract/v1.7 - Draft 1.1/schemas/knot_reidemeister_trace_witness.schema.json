{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_reidemeister_trace_witness.schema.json",
  "title": "KnotReidemeisterTraceWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_witness_id",
    "source_diagram_id",
    "target_diagram_id",
    "move_witness_refs",
    "trace_status",
    "replay_checker_ref",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_reidemeister_trace_witness/v1"
    },
    "trace_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "source_diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "target_diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "move_witness_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trace_status": {
      "enum": [
        "candidate",
        "replayed",
        "trace_verified",
        "rejected"
      ]
    },
    "replay_checker_ref": {
      "type": "string",
      "minLength": 1
    },
    "compression_policy": {
      "enum": [
        "uncompressed",
        "lossless_compressed",
        "summary_only_rejected"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
