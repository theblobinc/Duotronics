{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_equivalence_authority_path.schema.json",
  "title": "KnotEquivalenceAuthorityPath",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_path_id",
    "source_object_ref",
    "target_object_ref",
    "path_entries",
    "authority_status",
    "non_collapse_transition_id",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_equivalence_authority_path/v1"
    },
    "authority_path_id": {
      "type": "string",
      "minLength": 1
    },
    "equivalence_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "path_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_type",
          "witness_ref",
          "authority_status"
        ],
        "properties": {
          "path_type": {
            "enum": [
              "reidemeister_trace",
              "braid_relation_trace",
              "canonical_normal_form",
              "complete_invariant",
              "proof_witness",
              "external_theorem_authority"
            ]
          },
          "witness_ref": {
            "type": "string",
            "minLength": 1
          },
          "authority_status": {
            "enum": [
              "candidate",
              "computed_support",
              "trace_verified",
              "canonical_form_verified",
              "proof_verified",
              "rejected"
            ]
          },
          "domain_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority_status": {
      "enum": [
        "candidate",
        "computed_support",
        "trace_verified",
        "canonical_form_verified",
        "proof_verified",
        "rejected"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
