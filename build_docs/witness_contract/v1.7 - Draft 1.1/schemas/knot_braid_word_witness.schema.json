{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_braid_word_witness.schema.json",
  "title": "KnotBraidWordWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "braid_witness_id",
    "braid_id",
    "strand_count",
    "generator_sequence",
    "closure_convention",
    "orientation_policy",
    "claim_status",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_braid_word_witness/v1"
    },
    "braid_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "braid_id": {
      "type": "string",
      "minLength": 1
    },
    "strand_count": {
      "type": "integer",
      "minimum": 2
    },
    "generator_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "exponent"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "exponent": {
            "type": "integer"
          }
        }
      }
    },
    "closure_convention": {
      "enum": [
        "standard_closure",
        "plat_closure",
        "open_braid",
        "unknown_rejected"
      ]
    },
    "orientation_policy": {
      "enum": [
        "oriented",
        "unoriented",
        "unknown_rejected"
      ]
    },
    "source_diagram_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim_status": {
      "enum": [
        "candidate",
        "computed",
        "verified",
        "rejected"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
