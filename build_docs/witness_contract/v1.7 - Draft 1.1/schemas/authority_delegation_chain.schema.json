{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/authority_delegation_chain.schema.json",
  "title": "AuthorityDelegationChain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_chain_id",
    "delegator_principal_id",
    "delegate_principal_id",
    "scope",
    "force_limit",
    "valid_from",
    "valid_until",
    "policy_decision_id",
    "revoked",
    "delegation_depth",
    "delegation_path",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "authority_delegation_chain/v1"
    },
    "delegation_chain_id": {
      "type": "string"
    },
    "delegator_principal_id": {
      "type": "string"
    },
    "delegate_principal_id": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "none",
        "diagnostic",
        "local_session",
        "tenant",
        "repo",
        "service",
        "cluster",
        "system",
        "release",
        "mathematical_claim",
        "nla_training",
        "policy",
        "memory_write",
        "model_promotion",
        "truth_observer"
      ]
    },
    "force_limit": {
      "enum": [
        "observe",
        "propose",
        "assert",
        "veto",
        "delegate"
      ]
    },
    "runtime_mode_limit": {
      "enum": [
        "observe",
        "test",
        "simulation",
        "shadow",
        "audit",
        "migration",
        "release_candidate",
        "production",
        "rollback"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "channel_authority": {
      "enum": [
        "api",
        "mcp_tool",
        "cli",
        "admin_ui",
        "scheduler",
        "replay",
        "test_fixture",
        "human_review",
        "agent_runtime"
      ]
    },
    "policy_decision_id": {
      "type": "string"
    },
    "revoked": {
      "type": "boolean"
    },
    "delegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "parent_delegation_chain_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "delegation_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "revocation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Authority delegation chain with locked scope, force limit, runtime mode, channel authority, depth, and revocation semantics.",
  "allOf": [
    {
      "if": {
        "properties": {
          "revoked": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "revocation_reason"
        ]
      }
    }
  ]
}
