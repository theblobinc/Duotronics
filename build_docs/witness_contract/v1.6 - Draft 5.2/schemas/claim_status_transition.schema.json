{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/claim_status_transition.schema.json",
  "title": "ClaimStatusTransition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_status_transition_id",
    "claim_id",
    "source_status",
    "target_status",
    "transition_kind",
    "allowed",
    "policy_decision_id",
    "required_witness_refs",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "claim_status_transition/v1"
    },
    "claim_status_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_status": {
      "enum": [
        "unknown",
        "absent",
        "invalid",
        "draft",
        "observed",
        "computed",
        "proposed",
        "asserted",
        "deferred",
        "vetoed",
        "conjecture",
        "theorem",
        "replay_verified",
        "proof_verified",
        "policy_approved",
        "released"
      ]
    },
    "target_status": {
      "enum": [
        "unknown",
        "absent",
        "invalid",
        "draft",
        "observed",
        "computed",
        "proposed",
        "asserted",
        "deferred",
        "vetoed",
        "conjecture",
        "theorem",
        "replay_verified",
        "proof_verified",
        "policy_approved",
        "released"
      ]
    },
    "transition_kind": {
      "enum": [
        "observe",
        "compute",
        "propose",
        "assert",
        "defer",
        "veto",
        "prove",
        "replay_verify",
        "policy_approve",
        "release",
        "invalidate",
        "mark_absent",
        "mark_unknown"
      ]
    },
    "allowed": {
      "type": "boolean"
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "required_witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_witness_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "replay_verification_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target_status": {
            "enum": [
              "theorem",
              "proof_verified"
            ]
          }
        }
      },
      "then": {
        "required": [
          "proof_witness_refs"
        ],
        "properties": {
          "transition_kind": {
            "const": "prove"
          },
          "proof_witness_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
