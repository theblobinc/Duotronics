{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/theorem_promotion_gate_v3.schema.json",
  "title": "Ledger-Bound Theorem Promotion Gate v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "promotion_gate_id", "compiler_witness_id", "authority_snapshot_id", "approval_event_id", "created_at"],
  "properties": {
    "schema_version": {"const": "theorem_promotion_gate/v3"},
    "promotion_gate_id": {"type": "string", "minLength": 1},
    "compiler_witness_id": {"type": "string", "minLength": 1},
    "authority_snapshot_id": {"type": "string", "minLength": 1},
    "approval_event_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
