{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/build_attestation_v2.schema.json",
  "title": "Reproducible Inspector Build Attestation v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "subject_type", "source_tree_sha256", "build_command", "toolchain_identity", "dependency_lock_sha256", "output_binary_sha256", "image_identity", "reproducible_build_count", "status", "signer_key_id", "created_at", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "build_attestation/v2"}, "attestation_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["trusted_lean_inspector", "governed_oci_image"]}, "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "build_command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "toolchain_identity": {"type": "string", "minLength": 1},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}, "output_binary_sha256": {"$ref": "#/$defs/sha256"},
    "image_identity": {"type": ["string", "null"]}, "reproducible_build_count": {"type": "integer", "minimum": 2},
    "status": {"enum": ["passed", "failed", "not_run"]}, "signer_key_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}, "signed_payload_sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "minLength": 43}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
