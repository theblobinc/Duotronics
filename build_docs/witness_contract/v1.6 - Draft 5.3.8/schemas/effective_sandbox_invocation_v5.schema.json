{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/effective_sandbox_invocation_v5.schema.json",
  "title": "Evidence-Correct Sandbox Invocation v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "oci_runtime_path", "oci_runtime_sha256", "oci_runtime_version", "oci_runtime_version_output_sha256", "image_reference", "image_digest", "entrypoint", "arguments", "container_uid", "container_gid", "network_mode", "read_only_rootfs", "capability_drop_set", "security_options", "seccomp_profile_sha256", "seccomp_profile_path", "apparmor_profile", "selinux_label", "user_namespace_mode", "pid_limit", "memory_limit", "cpu_limit", "compiler_artifact_file_size_limit", "handoff_total_bytes_limit", "inspection_output_bytes_limit", "domain_file_size_limit", "final_result_bytes_limit", "stdout_bytes_limit", "stderr_bytes_limit", "combined_output_bytes_limit", "open_file_limit", "timeout", "environment_allowlist", "runtime_created_environment_keys", "mount_manifest", "tmpfs_mounts", "working_directory", "requested_controls", "emitted_controls", "accepted_controls", "applied_controls", "immutable_policy_files", "normalized_executed_argv", "normalized_executed_argv_sha256"],
  "properties": {
    "domain": {"enum": ["untrusted_compilation", "trusted_inspection"]},
    "oci_runtime_path": {"type": "string", "pattern": "^/"},
    "oci_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "oci_runtime_version": {"type": "string", "minLength": 1},
    "oci_runtime_version_output_sha256": {"$ref": "#/$defs/sha256"},
    "image_reference": {"type": "string", "minLength": 1},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entrypoint": {"type": "string", "pattern": "^/opt/witness-authority/bin/(compile|verify)-lean$"},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "container_uid": {"type": "integer", "minimum": 1},
    "container_gid": {"type": "integer", "minimum": 1},
    "network_mode": {"const": "none"},
    "read_only_rootfs": {"const": true},
    "capability_drop_set": {"type": "array", "contains": {"const": "ALL"}},
    "security_options": {"type": "array", "contains": {"const": "no-new-privileges"}},
    "seccomp_profile_sha256": {"$ref": "#/$defs/sha256"},
    "seccomp_profile_path": {"type": "string", "pattern": "^/"},
    "apparmor_profile": {"type": "string"},
    "selinux_label": {"type": "string"},
    "user_namespace_mode": {"type": "string", "minLength": 1},
    "pid_limit": {"type": "integer", "minimum": 1},
    "memory_limit": {"type": "string", "minLength": 1},
    "cpu_limit": {"type": "string", "minLength": 1},
    "compiler_artifact_file_size_limit": {"type": "integer", "minimum": 1048576, "maximum": 134217728},
    "handoff_total_bytes_limit": {"type": "integer", "minimum": 1048576},
    "inspection_output_bytes_limit": {"type": "integer", "minimum": 1024, "maximum": 4194304},
    "domain_file_size_limit": {"type": "integer", "minimum": 1024, "maximum": 134217728},
    "final_result_bytes_limit": {"type": "integer", "minimum": 1024},
    "stdout_bytes_limit": {"type": "integer", "minimum": 1024},
    "stderr_bytes_limit": {"type": "integer", "minimum": 1024},
    "combined_output_bytes_limit": {"type": "integer", "minimum": 2048},
    "open_file_limit": {"type": "integer", "minimum": 1},
    "timeout": {"type": "integer", "minimum": 1},
    "environment_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*=.*$"}},
    "runtime_created_environment_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
    "mount_manifest": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/mount"}},
    "tmpfs_mounts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/tmpfs"}},
    "working_directory": {"const": "/work"},
    "requested_controls": {"$ref": "#/$defs/control_set"},
    "emitted_controls": {"$ref": "#/$defs/control_set"},
    "accepted_controls": {"$ref": "#/$defs/evidence_control_set"},
    "applied_controls": {"$ref": "#/$defs/evidence_control_set"},
    "immutable_policy_files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "normalized_executed_argv": {"type": "array", "minItems": 10, "items": {"type": "string"}},
    "normalized_executed_argv_sha256": {"$ref": "#/$defs/sha256"}
  },
  "oneOf": [
    {"properties": {"apparmor_profile": {"type": "string", "minLength": 1}, "selinux_label": {"type": "string", "maxLength": 0}}},
    {"properties": {"apparmor_profile": {"type": "string", "maxLength": 0}, "selinux_label": {"type": "string", "minLength": 1}}}
  ],
  "allOf": [
    {"if": {"properties": {"domain": {"const": "untrusted_compilation"}}}, "then": {"properties": {"domain_file_size_limit": {"type": "integer", "minimum": 1048576, "maximum": 134217728}}}},
    {"if": {"properties": {"domain": {"const": "trusted_inspection"}}}, "then": {"properties": {"domain_file_size_limit": {"type": "integer", "minimum": 1024, "maximum": 4194304}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_control_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mount": {"type": "object", "additionalProperties": false, "required": ["source", "host_path", "destination", "mode", "domain", "purpose", "lifecycle"], "properties": {"source": {"type": "string", "minLength": 1}, "host_path": {"type": "string", "pattern": "^/"}, "destination": {"type": "string", "pattern": "^/"}, "mode": {"enum": ["ro", "rw"]}, "domain": {"enum": ["untrusted_compilation", "trusted_inspection"]}, "purpose": {"type": "string", "minLength": 1}, "lifecycle": {"const": "request"}}},
    "tmpfs": {"type": "object", "additionalProperties": false, "required": ["destination", "options"], "properties": {"destination": {"enum": ["/tmp", "/work"]}, "options": {"type": "string", "minLength": 1}}}
  }
}
