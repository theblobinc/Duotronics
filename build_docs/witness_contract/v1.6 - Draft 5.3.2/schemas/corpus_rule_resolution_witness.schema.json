{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/corpusRuleResolutionWitness.schema.json",
  "title": "CorpusRuleResolutionWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_rule_resolution_witness_id",
    "concept",
    "active_rule_ref",
    "version_selected",
    "supersession_chain",
    "ambiguity_status",
    "policy_decision_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "corpus_rule_resolution_witness/v1"
    },
    "corpus_rule_resolution_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "requested_rule_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_rule_ref": {
      "type": "string",
      "minLength": 1
    },
    "version_selected": {
      "type": "string",
      "minLength": 1
    },
    "supersession_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "compatibility_exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "ambiguity_status": {
      "enum": [
        "resolved",
        "ambiguous",
        "denied",
        "escalated",
        "forked"
      ]
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Witness proving that an active canonical rule was selected.",
  "allOf": [
    {
      "if": {
        "properties": {
          "ambiguity_status": {
            "enum": [
              "ambiguous",
              "denied",
              "escalated"
            ]
          }
        }
      },
      "then": {
        "required": [
          "kernel_error_witness_id"
        ],
        "properties": {
          "kernel_error_witness_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
