{
  "$defs": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/cache_registry_lineage_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_registry_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "governance_key_id": {
      "$ref": "#/$defs/id"
    },
    "historical_registries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "registry_file": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
            "type": "string"
          },
          "registry_shake256_512": {
            "$ref": "#/$defs/shake256_512"
          },
          "revoked_key_ids": {
            "items": {
              "$ref": "#/$defs/id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "stale_replay_policy": {
            "const": "authenticate_then_conflict"
          },
          "successor_registry_shake256_512": {
            "$ref": "#/$defs/shake256_512"
          }
        },
        "required": [
          "registry_shake256_512",
          "registry_file",
          "successor_registry_shake256_512",
          "stale_replay_policy",
          "revoked_key_ids"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "lineage_id": {
      "$ref": "#/$defs/id"
    },
    "schema_version": {
      "const": "cache_registry_lineage/v1"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    }
  },
  "required": [
    "schema_version",
    "lineage_id",
    "governance_key_id",
    "current_registry_shake256_512",
    "historical_registries",
    "created_at",
    "signed_payload_shake256_512",
    "signature"
  ],
  "title": "Governance-Signed Cache Registry Snapshot Lineage v1",
  "type": "object"
}
