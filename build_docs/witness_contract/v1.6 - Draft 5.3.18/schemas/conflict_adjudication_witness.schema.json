{
  "$id": "https://duotronics.local/schemas/conflictAdjudicationWitness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "unresolved",
              "escalated",
              "denied"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "kernel_error_witness_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kernel_error_witness_id"
        ]
      }
    }
  ],
  "description": "Typed adjudication witness for claim, authority, proof, replay, or memory conflicts.",
  "properties": {
    "authority_comparison_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "claim_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 2,
      "type": "array"
    },
    "conflict_adjudication_witness_id": {
      "minLength": 1,
      "type": "string"
    },
    "conflict_class": {
      "enum": [
        "factual",
        "temporal",
        "authority",
        "proof",
        "policy",
        "replay",
        "non_collapse",
        "memory"
      ]
    },
    "conflict_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_comparison_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_collapse_transition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "merged",
        "forked",
        "denied",
        "unresolved",
        "escalated",
        "superseded"
      ]
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "conflict_adjudication_witness/v1"
    }
  },
  "required": [
    "schema_version",
    "conflict_adjudication_witness_id",
    "conflict_id",
    "claim_refs",
    "conflict_class",
    "outcome",
    "policy_decision_id",
    "created_at"
  ],
  "title": "ConflictAdjudicationWitness",
  "type": "object"
}
