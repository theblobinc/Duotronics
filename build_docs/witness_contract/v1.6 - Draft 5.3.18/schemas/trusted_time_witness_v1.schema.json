{
  "$id": "https://duotronics.local/schemas/trusted_time_witness_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asserted_time": {
      "format": "date-time",
      "type": "string"
    },
    "clock_authority_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "const": "trusted_time_witness/v1"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "pattern": "^[A-Za-z0-9_-]{6170}$",
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "pattern": "^[a-f0-9]{128}$",
      "type": "string"
    },
    "time_witness_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "time_witness_id",
    "asserted_time",
    "clock_authority_id",
    "policy_decision_id",
    "signed_payload_shake256_512",
    "signature",
    "recorded_at"
  ],
  "title": "TrustedTimeWitnessV1",
  "type": "object"
}
