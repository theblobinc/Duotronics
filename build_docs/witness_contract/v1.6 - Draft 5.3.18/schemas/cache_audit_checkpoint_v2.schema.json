{
  "$id": "https://duotronics.local/schemas/cache_audit_checkpoint_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_epoch": {
      "minimum": 0,
      "type": "integer"
    },
    "anchor_namespace": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "anchor_registry_shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "anchor_state_shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "audit_key_validity_evidence": {
      "type": "object"
    },
    "audit_signer_key_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "audit_signing_registry_shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "checkpoint_created_at": {
      "format": "date-time",
      "type": "string"
    },
    "previous_sealed_segment_tail_shake256_512": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "cache_audit_checkpoint/v2"
    },
    "segment_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "segment_status": {
      "enum": [
        "open",
        "sealed"
      ]
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    },
    "tail_record_shake256_512": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "segment_id",
    "sequence",
    "tail_record_shake256_512",
    "previous_sealed_segment_tail_shake256_512",
    "audit_signer_key_id",
    "audit_signing_registry_shake256_512",
    "audit_key_validity_evidence",
    "anchor_namespace",
    "anchor_registry_shake256_512",
    "anchor_epoch",
    "anchor_state_shake256_512",
    "segment_status",
    "checkpoint_created_at",
    "signed_payload_shake256_512",
    "signature"
  ],
  "title": "Externally Anchored Local Cache Audit Checkpoint v2",
  "type": "object"
}
