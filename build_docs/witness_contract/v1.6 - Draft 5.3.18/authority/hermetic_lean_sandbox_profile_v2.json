{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "hermetic_lean_sandbox_profile/v2",
  "profile_id": "wc-hermetic-lean-v2-two-domain",
  "result_channel_architecture": "untrusted_compile_then_trusted_signed_verifier",
  "untrusted_compilation_domain": {
    "source_mount": "read_only_sealed_snapshot",
    "generated_mount": "read_only_0555_0444",
    "handoff_mount": "bounded_write_only_compiler_artifacts",
    "verifier_request_mount": "absent",
    "final_result_mount": "absent",
    "governance_state_mount": "absent",
    "signing_key_mount": "absent"
  },
  "trusted_verifier_domain": {
    "source_mount": "read_only_sealed_snapshot",
    "generated_mount": "read_only_0555_0444",
    "handoff_mount": "read_only_untrusted_artifacts",
    "verifier_request_mount": "read_only_private_control",
    "inspection_output_mount": "private_0700_authority_uid",
    "final_result_mount": "absent",
    "inspection_file": "regular_0600_single_link_exclusive_atomic",
    "result_signature": "separate_host_authority_component_with_authorized_ml_dsa_87_verifier_result_key"
  },
  "runtime_controls": {
    "working_directory": "/work",
    "network_mode": "none",
    "read_only_rootfs": true,
    "capability_drop_set": ["ALL"],
    "security_options": ["no-new-privileges"],
    "seccomp_profile": "required_immutable_governed_file",
    "apparmor_profile": "witness-authority-lean",
    "selinux_label": "witness_authority_lean_t",
    "user_namespace_mode": "private",
    "container_uid": 65534,
    "container_gid": 65534,
    "pid_limit": 128,
    "memory_limit": "2g",
    "cpu_limit": "2",
    "file_size_limit_bytes": 1048576,
    "open_file_limit": 256,
    "timeout_seconds": 600,
    "environment_allowlist": ["HOME=/nonexistent", "LANG=C.UTF-8", "LC_ALL=C.UTF-8", "TZ=UTC", "SOURCE_DATE_EPOCH=0", "LEAN_ABORT_ON_PANIC=1"],
    "host_home": "absent",
    "docker_socket": "absent",
    "authority_database": "absent_from_untrusted",
    "host_compiler_cache": "absent",
    "source_mount_writable": false
  },
  "effective_invocation_schema": "schemas/effective_sandbox_invocation_v2.schema.json",
  "sandbox_template_schema": "schemas/sandbox_template_v1.schema.json",
  "effective_invocation_measurement": "canonical_hash_of_exact_applied_argv_and_immutable_policy_file_hashes",
  "control_state_model": "requested_applied_verified_separated",
  "runtime_inspection": "required_for_every_policy_required_verifiable_control",
  "stdout_authority": false,
  "contract_freeze_policy": "permanently_unfrozen"
}
