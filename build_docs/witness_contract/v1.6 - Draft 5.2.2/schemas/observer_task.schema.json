{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/observerTask.schema.json",
  "title": "ObserverTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "observer_id",
    "task_kind",
    "requested_syscall",
    "input_refs",
    "capability_token_id",
    "resource_budget_id",
    "policy_decision_id",
    "pragmatic_context_id",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "observer_task/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "task_kind": {
      "enum": [
        "observe",
        "compose",
        "infer",
        "verify",
        "replay",
        "delegate",
        "promote",
        "compute",
        "adjudicate",
        "rollback",
        "export",
        "resolve_rule",
        "memory_write"
      ]
    },
    "requested_syscall": {
      "enum": [
        "observe",
        "compose",
        "infer",
        "verify",
        "replay",
        "delegate",
        "promote",
        "compute",
        "adjudicate",
        "rollback",
        "export",
        "resolve_rule",
        "read_memory",
        "write_observation",
        "promote_memory",
        "raise_error"
      ]
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "capability_token_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_budget_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "pragmatic_context_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_result_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "typechecked",
        "running",
        "committed",
        "denied",
        "deferred",
        "escalated",
        "rolled_back",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "description": "First-class logical observer task.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "committed"
          }
        }
      },
      "then": {
        "required": [
          "task_result_witness_id"
        ],
        "properties": {
          "task_result_witness_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "denied",
              "escalated",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "kernel_error_witness_id"
        ],
        "properties": {
          "kernel_error_witness_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
