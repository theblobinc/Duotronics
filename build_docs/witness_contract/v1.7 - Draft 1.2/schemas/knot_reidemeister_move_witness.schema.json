{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_reidemeister_move_witness.schema.json",
  "title": "KnotReidemeisterMoveWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "move_witness_id",
    "source_diagram_id",
    "target_diagram_id",
    "move_type",
    "checked",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_reidemeister_move_witness/v1"
    },
    "move_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "source_diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "target_diagram_id": {
      "type": "string",
      "minLength": 1
    },
    "move_type": {
      "enum": [
        "R1",
        "R1_inverse",
        "R2",
        "R2_inverse",
        "R3",
        "isotopy_relabeled"
      ]
    },
    "affected_crossings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checked": {
      "type": "boolean"
    },
    "checker_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
