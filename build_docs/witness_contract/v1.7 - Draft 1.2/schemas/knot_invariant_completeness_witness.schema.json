{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_invariant_completeness_witness.schema.json",
  "title": "KnotInvariantCompletenessWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "completeness_witness_id",
    "invariant_witness_id",
    "invariant_kind",
    "domain_ref",
    "completeness_status",
    "proof_witness_ref",
    "lean_compiler_witness_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_invariant_completeness_witness/v1"
    },
    "completeness_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "invariant_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "invariant_kind": {
      "type": "string",
      "minLength": 1
    },
    "domain_ref": {
      "type": "string",
      "minLength": 1
    },
    "completeness_status": {
      "enum": [
        "domain_limited_complete",
        "incomplete",
        "unknown_rejected",
        "rejected"
      ]
    },
    "proof_witness_ref": {
      "type": "string",
      "minLength": 1
    },
    "lean_compiler_witness_ref": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
