{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/replay_assumption_manifest.schema.json",
  "title": "ReplayAssumptionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "semantic_assumptions",
    "metrological_assumptions",
    "computational_assumptions",
    "schema_assumptions",
    "deep_time_intent",
    "required_assumptions",
    "failure_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "replay_assumption_manifest/v1"
    },
    "manifest_id": {
      "type": "string"
    },
    "semantic_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "cultural_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "default": []
    },
    "metrological_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "computational_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "schema_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "policy_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "default": []
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "deep_time_intent": {
      "enum": [
        "none",
        "local_replay",
        "deep_time_replay",
        "migration_replay",
        "cross_version_replay"
      ]
    },
    "required_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Assumption ids that must be satisfied before deep-time replay may pass."
    },
    "failure_mode": {
      "enum": [
        "block",
        "reject",
        "escalate",
        "mark_inconclusive"
      ]
    }
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "description",
        "assumption_type",
        "scope",
        "validation_method",
        "failure_mode"
      ],
      "properties": {
        "assumption_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required_for_deep_time": {
          "type": "boolean",
          "default": false
        },
        "assumption_type": {
          "enum": [
            "semantic",
            "cultural",
            "metrological",
            "computational",
            "schema",
            "policy",
            "cryptographic",
            "environmental",
            "temporal"
          ]
        },
        "scope": {
          "enum": [
            "claim",
            "corpus",
            "runtime",
            "artifact",
            "schema",
            "policy",
            "replay_package",
            "environment"
          ]
        },
        "validation_method": {
          "enum": [
            "schema_validation",
            "hash_check",
            "policy_check",
            "human_attestation",
            "deterministic_replay",
            "formal_model_check",
            "external_witness",
            "not_validatable"
          ]
        },
        "failure_mode": {
          "enum": [
            "block",
            "reject",
            "escalate",
            "mark_inconclusive"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "satisfied",
            "unsatisfied",
            "unknown",
            "waived_with_policy"
          ]
        }
      }
    }
  },
  "description": "Replay assumption manifest with deep-time replay intent and explicit failure behavior."
}
