{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/knot_braid_relation_witness.schema.json",
  "title": "KnotBraidRelationWitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "braid_relation_witness_id",
    "source_braid_id",
    "target_braid_id",
    "relation_type",
    "checked",
    "non_collapse_transition_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "knot_braid_relation_witness/v1"
    },
    "braid_relation_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "source_braid_id": {
      "type": "string",
      "minLength": 1
    },
    "target_braid_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_type": {
      "enum": [
        "artin_commutation",
        "artin_braid_relation",
        "free_reduction",
        "cyclic_conjugation"
      ]
    },
    "checked": {
      "type": "boolean"
    },
    "checker_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}