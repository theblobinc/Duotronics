{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_posterior_state.schema.json",
  "title": "BayesianPosteriorState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "posterior_id",
    "model_id",
    "update_witness_id",
    "hypothesis_distribution",
    "normalization_status",
    "non_collapse_transition_id",
    "posterior_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_posterior_state/v1"
    },
    "posterior_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "update_witness_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis_distribution": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "probability"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "support_ref": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "normalization_status": {
      "enum": [
        "normalized",
        "approximate_declared",
        "rejected"
      ]
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "posterior_status": {
      "enum": [
        "candidate",
        "computed",
        "calibrated",
        "rejected"
      ]
    },
    "approximation_error_bound": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
