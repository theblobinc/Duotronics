{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/bayesian_calibration_report.schema.json",
  "title": "BayesianCalibrationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_report_id",
    "model_id",
    "posterior_refs",
    "scoring_rule",
    "calibration_status",
    "limitations",
    "non_collapse_transition_id",
    "created_at",
    "scoring_rule_definition_id"
  ],
  "properties": {
    "schema_version": {
      "const": "bayesian_calibration_report/v1"
    },
    "calibration_report_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "posterior_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scoring_rule": {
      "enum": [
        "brier",
        "log_score",
        "reliability_bins",
        "expected_calibration_error",
        "custom"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "calibration_status": {
      "enum": [
        "uncalibrated",
        "calibrated_candidate",
        "calibrated_reviewed",
        "rejected"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "non_collapse_transition_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring_rule_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "reliability_bins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bin_id",
          "count",
          "mean_predicted_probability",
          "empirical_frequency"
        ],
        "additionalProperties": false,
        "properties": {
          "bin_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "mean_predicted_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "empirical_frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
