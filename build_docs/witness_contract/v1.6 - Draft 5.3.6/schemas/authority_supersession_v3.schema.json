{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/authority_supersession_v3.schema.json",
  "title": "Typed Authority Supersession v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "supersession_id", "record_type", "superseded_record_id", "replacement_record_id", "reason", "governance_event_id", "effective_at"],
  "properties": {
    "schema_version": {"const": "authority_supersession/v3"}, "supersession_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["verifier_key", "compiler_profile", "promotion_gate", "authority_snapshot", "compiler_witness", "proof_witness"]},
    "superseded_record_id": {"type": "string", "minLength": 1}, "replacement_record_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "governance_event_id": {"type": "string", "minLength": 1}, "effective_at": {"type": "string", "format": "date-time"}
  }
}
