{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_compiler_witness_v2.schema.json",
  "title": "LeanCompilerWitnessV2Draft533",
  "description": "Server-produced Draft 5.3.3 witness for a governed, hermetic, clean-source Lean verification with structured declaration/type/axiom inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lean_compiler_witness_id", "claim_id", "claim_content_sha256",
    "theorem_statement_sha256", "proof_artifact_sha256", "proof_artifact_relative_path",
    "proof_module", "source_tree_sha256", "original_source_tree_sha256",
    "immutable_snapshot_sha256", "lakefile_sha256", "generated_witness_module_sha256",
    "generated_witness_module_path", "exact_build_target", "compiler_profile_id",
    "compiler_registry_sha256", "lake_executable_sha256", "lean_executable_sha256",
    "lean_stdlib_tree_sha256", "dependency_closure_sha256", "execution_image_digest",
    "sandbox_policy_sha256", "verifier_binary_sha256", "compiler_executable_sha256",
    "structured_result_sha256", "build_output_sha256", "toolchain", "command",
    "execution_mode", "result", "contains_sorry", "contains_admit",
    "unapproved_axiom_count", "axiom_dependencies", "axiom_inspection_complete",
    "statement_binding_confirmed", "warnings_as_errors", "snapshot_verified_immutable",
    "clean_source_build", "prebuilt_artifacts_rejected", "hermetic_environment",
    "network_disabled", "resource_limits_enforced", "structured_inspection_complete",
    "theorem_name", "theorem_status", "verifier_principal_id", "key_id",
    "signature_algorithm", "trusted_timestamp_source", "signed_payload_sha256",
    "signature", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "lean_compiler_witness/v2"},
    "lean_compiler_witness_id": {"type": "string", "pattern": "^lean:[A-Za-z0-9._:-]+$"},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_content_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "proof_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "proof_artifact_relative_path": {"type": "string", "minLength": 1},
    "proof_module": {"type": "string", "minLength": 1},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "original_source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "immutable_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "lakefile_sha256": {"$ref": "#/$defs/sha256"},
    "generated_witness_module_sha256": {"$ref": "#/$defs/sha256"},
    "generated_witness_module_path": {"type": "string", "pattern": "^\\.witness_authority/Check_[a-f0-9]{32}\\.lean$"},
    "exact_build_target": {"type": "string", "pattern": "^\\.witness_authority/Check_[a-f0-9]{32}\\.lean$"},
    "compiler_profile_id": {"type": "string", "minLength": 1},
    "compiler_registry_sha256": {"$ref": "#/$defs/sha256"},
    "lake_executable_sha256": {"$ref": "#/$defs/sha256"},
    "lean_executable_sha256": {"$ref": "#/$defs/sha256"},
    "lean_stdlib_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
    "execution_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sandbox_policy_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_binary_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_executable_sha256": {"$ref": "#/$defs/sha256"},
    "structured_result_sha256": {"$ref": "#/$defs/sha256"},
    "build_output_sha256": {"$ref": "#/$defs/sha256"},
    "toolchain": {"type": "string", "minLength": 1},
    "command": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "execution_mode": {"const": "strict"},
    "result": {"enum": ["passed", "failed", "toolchain_unavailable", "failed_static_scan", "failed_lake_build", "signature_failed"]},
    "contains_sorry": {"type": "boolean"},
    "contains_admit": {"type": "boolean"},
    "unapproved_axiom_count": {"type": "integer", "minimum": 0},
    "axiom_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "axiom_inspection_complete": {"type": "boolean"},
    "statement_binding_confirmed": {"type": "boolean"},
    "warnings_as_errors": {"type": "boolean"},
    "snapshot_verified_immutable": {"type": "boolean"},
    "clean_source_build": {"type": "boolean"},
    "prebuilt_artifacts_rejected": {"type": "boolean"},
    "hermetic_environment": {"type": "boolean"},
    "network_disabled": {"type": "boolean"},
    "resource_limits_enforced": {"type": "boolean"},
    "structured_inspection_complete": {"type": "boolean"},
    "theorem_name": {"type": "string", "minLength": 1},
    "theorem_status": {"enum": ["proved", "failed", "sorry_stub", "axiom_dependent", "source_hash_mismatch"]},
    "verifier_principal_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "Ed25519"},
    "trusted_timestamp_source": {"type": "string", "minLength": 1},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "passed"}}, "required": ["result"]},
      "then": {"properties": {
        "contains_sorry": {"const": false}, "contains_admit": {"const": false},
        "unapproved_axiom_count": {"const": 0}, "axiom_inspection_complete": {"const": true},
        "statement_binding_confirmed": {"const": true}, "warnings_as_errors": {"const": true},
        "snapshot_verified_immutable": {"const": true}, "clean_source_build": {"const": true},
        "prebuilt_artifacts_rejected": {"const": true}, "hermetic_environment": {"const": true},
        "network_disabled": {"const": true}, "resource_limits_enforced": {"const": true},
        "structured_inspection_complete": {"const": true}, "theorem_status": {"const": "proved"}
      }}
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
