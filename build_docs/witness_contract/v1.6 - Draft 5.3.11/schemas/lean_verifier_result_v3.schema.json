{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_verifier_result_v3.schema.json",
  "title": "Trusted Lean Verifier Result v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "request_id", "request_sha256", "compiler_profile_id", "claim_content_sha256", "policy_decision_id", "policy_decision_sha256", "theorem_statement_sha256", "proof_artifact_sha256", "immutable_snapshot_id", "immutable_snapshot_tree_sha256", "generated_binding_module_sha256", "lake_executable_sha256", "lean_executable_sha256", "lean_stdlib_tree_sha256", "dependency_closure_sha256", "oci_image_digest", "oci_runtime_sha256", "oci_runtime_version", "oci_runtime_version_output_sha256", "verifier_executable_sha256", "sandbox_policy_sha256", "effective_sandbox_invocation_sha256", "theorem_declaration", "declaration_found", "declaration_type_matches", "expected_type_expression_hash", "actual_type_expression_hash", "normalization_policy", "direct_dependencies", "transitive_dependencies_root", "axiom_set", "axiom_set_sha256", "forbidden_axiom_set", "sorry_ax_present", "unsafe_dependency_present", "opaque_dependency_policy_result", "build_from_source", "prebuilt_artifacts_used", "warnings_as_errors", "exit_status", "timeout_status", "execution_started_at", "execution_finished_at", "verifier_result_signer_key_id", "requested_controls", "applied_controls", "verified_controls", "stdout_sha256", "stderr_sha256", "output_limit_exceeded", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "wc_lean_verifier_result/v3"}, "status": {"enum": ["passed", "failed"]},
    "request_id": {"type": "string", "minLength": 1}, "request_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_profile_id": {"type": "string", "minLength": 1}, "claim_content_sha256": {"$ref": "#/$defs/sha256"},
    "policy_decision_id": {"type": "string", "minLength": 1}, "policy_decision_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_statement_sha256": {"$ref": "#/$defs/sha256"}, "proof_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "immutable_snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "immutable_snapshot_tree_sha256": {"$ref": "#/$defs/sha256"},
    "generated_binding_module_sha256": {"$ref": "#/$defs/sha256"}, "lake_executable_sha256": {"$ref": "#/$defs/sha256"},
    "lean_executable_sha256": {"$ref": "#/$defs/sha256"}, "lean_stdlib_tree_sha256": {"$ref": "#/$defs/sha256"}, "dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
    "oci_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "oci_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "oci_runtime_version": {"type": "string", "minLength": 1}, "oci_runtime_version_output_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_executable_sha256": {"$ref": "#/$defs/sha256"}, "sandbox_policy_sha256": {"$ref": "#/$defs/sha256"}, "effective_sandbox_invocation_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_declaration": {"type": "string", "minLength": 1}, "declaration_found": {"type": "boolean"}, "declaration_type_matches": {"type": "boolean"},
    "expected_type_expression_hash": {"$ref": "#/$defs/sha256"}, "actual_type_expression_hash": {"$ref": "#/$defs/sha256"}, "normalization_policy": {"const": "lean_isDefEq_reducibility_regular/v1"},
    "direct_dependencies": {"$ref": "#/$defs/name_set"}, "transitive_dependencies_root": {"$ref": "#/$defs/sha256"}, "axiom_set": {"$ref": "#/$defs/name_set"}, "axiom_set_sha256": {"$ref": "#/$defs/sha256"}, "forbidden_axiom_set": {"$ref": "#/$defs/name_set"},
    "sorry_ax_present": {"type": "boolean"}, "unsafe_dependency_present": {"type": "boolean"}, "opaque_dependency_policy_result": {"enum": ["passed", "failed", "not_evaluated"]},
    "build_from_source": {"type": "boolean"}, "prebuilt_artifacts_used": {"type": "boolean"}, "warnings_as_errors": {"type": "boolean"},
    "exit_status": {"type": "integer"}, "timeout_status": {"enum": ["completed", "timed_out"]}, "execution_started_at": {"type": "string", "format": "date-time"}, "execution_finished_at": {"type": "string", "format": "date-time"},
    "verifier_result_signer_key_id": {"type": "string", "minLength": 1}, "requested_controls": {"$ref": "#/$defs/name_set"}, "applied_controls": {"$ref": "#/$defs/name_set"}, "verified_controls": {"$ref": "#/$defs/name_set"},
    "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "output_limit_exceeded": {"type": "boolean"},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "minLength": 43}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"declaration_found": {"const": true}, "declaration_type_matches": {"const": true}, "sorry_ax_present": {"const": false}, "unsafe_dependency_present": {"const": false}, "forbidden_axiom_set": {"type": "array", "maxItems": 0}, "build_from_source": {"const": true}, "prebuilt_artifacts_used": {"const": false}, "warnings_as_errors": {"const": true}, "timeout_status": {"const": "completed"}, "exit_status": {"const": 0}, "output_limit_exceeded": {"const": false}, "opaque_dependency_policy_result": {"const": "passed"}}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "name_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
