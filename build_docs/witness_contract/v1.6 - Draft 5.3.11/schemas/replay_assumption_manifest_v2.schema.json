{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/replay_assumption_manifest_v2.schema.json",
  "title": "ReplayAssumptionManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "deep_time_intent", "assumptions", "required_assumption_ids", "failure_mode", "manifest_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "replay_assumption_manifest/v2"},
    "manifest_id": {"type": "string", "minLength": 1},
    "deep_time_intent": {"enum": ["local_replay", "deep_time_replay", "migration_replay", "cross_version_replay"]},
    "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assumption"}},
    "required_assumption_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failure_mode": {"enum": ["block", "reject", "escalate", "mark_inconclusive"]},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "description", "assumption_type", "validation_method", "required_for_pass", "status"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "assumption_type": {"enum": ["semantic", "metrological", "computational", "schema", "policy", "cryptographic", "environmental", "temporal"]},
        "validation_method": {"enum": ["schema_validation", "hash_check", "policy_check", "human_attestation", "deterministic_replay", "formal_model_check", "external_witness"]},
        "required_for_pass": {"type": "boolean"},
        "status": {"enum": ["satisfied", "unsatisfied", "unknown", "waived_with_policy"]},
        "evidence_ref": {"type": ["string", "null"]}
      }
    }
  }
}
