{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/proof_check_result_v7.schema.json",
  "title": "Authenticated Deadline-Complete Synchronous Proof Check Result v7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_sha256", "idempotency_key", "authenticated_principal_id", "status", "claim_id", "claim_content_sha256", "theorem_statement_sha256", "compiler_profile_id", "policy_decision_id", "policy_decision_sha256", "source_bundle_id", "proof_artifact_relative_path", "compiler_witness"],
  "properties": {
    "schema_version": {"const": "proof_check_service_result/v7"},
    "request_id": {"$ref": "#/$defs/id"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "authenticated_principal_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["passed", "failed", "toolchain_unavailable"]},
    "claim_id": {"$ref": "#/$defs/id"},
    "claim_content_sha256": {"$ref": "#/$defs/sha256"},
    "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_profile_id": {"$ref": "#/$defs/id"},
    "policy_decision_id": {"$ref": "#/$defs/id"},
    "policy_decision_sha256": {"$ref": "#/$defs/sha256"},
    "source_bundle_id": {"$ref": "#/$defs/id"},
    "proof_artifact_relative_path": {"type": "string", "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\)(?!.*//)(?![.]/).+[.]lean$"},
    "compiler_witness": {"$ref": "lean_compiler_witness_v8.schema.json"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
