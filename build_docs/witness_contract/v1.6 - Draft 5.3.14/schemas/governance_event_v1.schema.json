{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/governance_event_v1.schema.json",
  "title": "Signed Authority Governance Event v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authority_event_sequence", "event_id", "event_type", "action_scope", "target_type", "target_id", "effective_at", "recorded_at", "reason_code", "rationale", "governance_policy_version", "canonical_payload_sha256", "authorization_witness_id", "signer_key_id", "signature", "is_backdated", "correction_reason", "prior_affected_snapshot_ids", "correction_mode", "backdate_authorization_witness_id"],
  "properties": {
    "schema_version": {"const": "governance_event/v1"}, "authority_event_sequence": {"type": "integer", "minimum": 1}, "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["verifier_key_activate", "verifier_key_retire", "verifier_key_revoke", "compiler_profile_activate", "compiler_profile_revoke", "promotion_gate_approve", "promotion_gate_withdraw", "authority_record_supersede", "authority_snapshot_create", "authority_snapshot_supersede", "backdated_event_authorize"]},
    "action_scope": {"enum": ["verifier_key_activate", "verifier_key_retire", "verifier_key_revoke", "compiler_profile_activate", "compiler_profile_revoke", "promotion_gate_approve", "promotion_gate_withdraw", "authority_record_supersede", "authority_snapshot_create", "authority_snapshot_supersede", "backdated_event_authorize"]}, "target_type": {"type": "string", "minLength": 1}, "target_id": {"type": "string", "minLength": 1}, "effective_at": {"type": "string", "format": "date-time"}, "recorded_at": {"type": "string", "format": "date-time"},
    "reason_code": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "governance_policy_version": {"type": "string", "minLength": 1}, "canonical_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorization_witness_id": {"type": "string", "minLength": 1}, "signer_key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 43},
    "is_backdated": {"type": "boolean"}, "correction_reason": {"type": ["string", "null"]}, "prior_affected_snapshot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "correction_mode": {"enum": ["not_applicable", "prospective_only", "requires_snapshot_supersession"]}, "backdate_authorization_witness_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"is_backdated": {"const": true}}}, "then": {"properties": {"correction_reason": {"type": "string", "minLength": 1}, "prior_affected_snapshot_ids": {"type": "array", "minItems": 1}, "correction_mode": {"enum": ["prospective_only", "requires_snapshot_supersession"]}, "backdate_authorization_witness_id": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"event_type": {"const": "verifier_key_activate"}}}, "then": {"properties": {"action_scope": {"const": "verifier_key_activate"}, "target_type": {"const": "verifier_key"}}}},
    {"if": {"properties": {"event_type": {"const": "verifier_key_retire"}}}, "then": {"properties": {"action_scope": {"const": "verifier_key_retire"}, "target_type": {"const": "verifier_key"}}}},
    {"if": {"properties": {"event_type": {"const": "verifier_key_revoke"}}}, "then": {"properties": {"action_scope": {"const": "verifier_key_revoke"}, "target_type": {"const": "verifier_key"}}}},
    {"if": {"properties": {"event_type": {"const": "compiler_profile_activate"}}}, "then": {"properties": {"action_scope": {"const": "compiler_profile_activate"}, "target_type": {"const": "compiler_profile"}}}},
    {"if": {"properties": {"event_type": {"const": "compiler_profile_revoke"}}}, "then": {"properties": {"action_scope": {"const": "compiler_profile_revoke"}, "target_type": {"const": "compiler_profile"}}}},
    {"if": {"properties": {"event_type": {"const": "promotion_gate_approve"}}}, "then": {"properties": {"action_scope": {"const": "promotion_gate_approve"}, "target_type": {"const": "promotion_gate"}}}},
    {"if": {"properties": {"event_type": {"const": "promotion_gate_withdraw"}}}, "then": {"properties": {"action_scope": {"const": "promotion_gate_withdraw"}, "target_type": {"const": "promotion_gate"}}}},
    {"if": {"properties": {"event_type": {"const": "authority_snapshot_create"}}}, "then": {"properties": {"action_scope": {"const": "authority_snapshot_create"}, "target_type": {"const": "authority_snapshot"}}}},
    {"if": {"properties": {"event_type": {"const": "authority_snapshot_supersede"}}}, "then": {"properties": {"action_scope": {"const": "authority_snapshot_supersede"}, "target_type": {"const": "authority_snapshot"}}}},
    {"if": {"properties": {"event_type": {"const": "backdated_event_authorize"}}}, "then": {"properties": {"action_scope": {"const": "backdated_event_authorize"}, "target_type": {"const": "authority_event"}}}},
    {"if": {"properties": {"event_type": {"const": "authority_record_supersede"}}}, "then": {"properties": {"action_scope": {"const": "authority_record_supersede"}}}}
  ]
}
