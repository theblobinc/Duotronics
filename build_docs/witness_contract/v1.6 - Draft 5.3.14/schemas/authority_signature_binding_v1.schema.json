{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/authority_signature_binding_v1.schema.json",
  "title": "AuthoritySignatureBindingV1",
  "description": "Database record proving that a signed canonical payload exactly matches an authority record and verifies under its effective Ed25519 key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signature_binding_id", "record_type", "record_id", "key_id", "signed_payload_canonical_json", "signed_payload_sha256", "signature_verified_at"],
  "properties": {
    "schema_version": {"const": "authority_signature_binding/v1"},
    "signature_binding_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["lean_compiler_witness", "proof_witness"]},
    "record_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signed_payload_canonical_json": {"type": "string", "minLength": 2},
    "signed_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_verified_at": {"type": "string", "format": "date-time"}
  }
}
