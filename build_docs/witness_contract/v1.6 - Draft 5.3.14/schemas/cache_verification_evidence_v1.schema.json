{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/cache_verification_evidence_v1.schema.json",
  "title": "Current Cache Replay Verification Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cache_envelope_id", "cache_registry_sha256",
    "signing_decision", "replay_decision", "compiler_witness_signed_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cache_verification_evidence/v1"},
    "cache_envelope_id": {"type": "string", "pattern": "^cache:[0-9a-f]{64}$"},
    "cache_registry_sha256": {"$ref": "#/$defs/sha256"},
    "signing_decision": {"$ref": "#/$defs/decision"},
    "replay_decision": {"$ref": "#/$defs/decision"},
    "compiler_witness_signed_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registry_sha256", "key_id", "principal_id", "status",
        "valid_from", "valid_until", "status_changed_at", "rotation_predecessor_key_id",
        "use", "decision", "evaluated_at"
      ],
      "properties": {
        "schema_version": {"const": "cache_key_validity_evidence/v1"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "key_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "status": {"const": "active"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "status_changed_at": {"type": "string", "format": "date-time"},
        "rotation_predecessor_key_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "use": {"enum": ["signing", "replay"]},
        "decision": {"const": "active_time_valid_rotation_valid"},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
