{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "hermetic_lean_sandbox_profile/v5",
  "profile_id": "wc-hermetic-lean-v5-authenticated-cache-safe",
  "result_channel_architecture": "untrusted_compile_then_trusted_signed_verifier",
  "untrusted_compilation_domain": {
    "source_mount": "read_only_sealed_snapshot",
    "generated_mount": "read_only_0555_0444",
    "handoff_mount": "bounded_write_only_compiler_artifacts",
    "verifier_request_mount": "absent",
    "final_result_mount": "absent",
    "governance_state_mount": "absent",
    "signing_key_mount": "absent"
  },
  "trusted_inspection_domain": {
    "source_mount": "read_only_sealed_snapshot",
    "generated_mount": "read_only_0555_0444",
    "handoff_mount": "read_only_untrusted_artifacts",
    "verifier_request_mount": "read_only_private_control",
    "inspection_output_mount": "private_0700_authority_uid",
    "final_result_mount": "absent",
    "inspection_file": "regular_0600_single_link_exclusive_atomic",
    "result_signature": "separate_host_authority_component_with_authorized_ed25519_verifier_result_key"
  },
  "runtime_controls": {
    "working_directory": "/work",
    "network_mode": "none",
    "read_only_rootfs": true,
    "capability_drop_set": ["ALL"],
    "security_options": ["no-new-privileges"],
    "seccomp_profile": "required_immutable_governed_file",
    "lsm_profile": {"selection": "exactly_one", "apparmor_profile": "witness-authority-lean", "selinux_label": "witness_authority_lean_t"},
    "user_namespace_mode": "keep-id",
    "container_uid": 65534,
    "container_gid": 65534,
    "pid_limit": 128,
    "memory_limit": "2g",
    "cpu_limit": "2",
    "compiler_artifact_file_size_limit_bytes": 134217728,
    "handoff_total_bytes_limit": 536870912,
    "inspection_output_bytes_limit": 4194304,
    "final_result_bytes_limit": 1048576,
    "open_file_limit": 256,
    "timeout_seconds": 600,
    "environment_allowlist": ["HOME=/nonexistent", "PATH=/usr/bin:/bin", "LANG=C.UTF-8", "LC_ALL=C.UTF-8", "TZ=UTC", "SOURCE_DATE_EPOCH=0", "LEAN_ABORT_ON_PANIC=1", "PYTHONPATH="],
    "runtime_created_environment_keys": ["HOSTNAME", "container"],
    "image_environment_policy": "unset_all_then_add_literal_allowlist",
    "environment_measurement": "complete_actual_key_set_must_be_subset_of_literal_and_runtime_created_permitted_keys",
    "host_home": "absent",
    "docker_socket": "absent",
    "authority_database": "absent_from_untrusted",
    "host_compiler_cache": "absent",
    "source_mount_writable": false
  },
  "domain_file_size_limit_binding": {
    "untrusted_compilation": "compiler_artifact_file_size_limit_bytes",
    "trusted_inspection": "inspection_output_bytes_limit"
  },
  "effective_invocation_schema": "schemas/effective_sandbox_invocation_v5.schema.json",
  "sandbox_template_schema": "schemas/sandbox_template_v1.schema.json",
  "effective_invocation_measurement": "canonical_hash_of_exact_normalized_executed_argv_mount_host_paths_tmpfs_quotas_domain_limit_and_immutable_policy_file_hashes",
  "control_state_model": "requested_emitted_accepted_applied_measured_and_derived_are_separate",
  "required_file_size_measurement": "rlimit_fsize_exactly_equals_domain_file_size_limit",
  "lsm_policy": "exactly_one_governed_apparmor_or_selinux_profile",
  "compile_handoff": "exact_schema_validated_file_set_digest_mode_and_aggregate_limit",
  "runtime_inspection": "one_governed_evidence_class_required_for_every_requested_control_including_explicit_entrypoint_and_environment_allowlist",
  "stdout_authority": false,
  "contract_freeze_policy": "permanently_unfrozen"
}
