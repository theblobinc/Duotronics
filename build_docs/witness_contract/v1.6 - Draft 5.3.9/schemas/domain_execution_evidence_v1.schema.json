{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/domain_execution_evidence_v1.schema.json",
  "title": "Trusted OCI Domain Execution Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "domain", "evidence_source", "invocation_sha256",
    "normalized_executed_argv", "normalized_executed_argv_sha256",
    "mount_manifest", "runtime_identity", "requested_controls",
    "emitted_controls", "accepted_controls", "applied_controls",
    "measured_controls", "control_evidence", "container_uid",
    "container_gid", "host_directory_uid", "host_directory_gid",
    "user_namespace_mode", "domain_file_size_limit", "stdout_bytes_limit",
    "stderr_bytes_limit", "combined_output_bytes_limit",
    "request_budget_seconds", "remaining_at_start_ms", "elapsed_ms",
    "remaining_at_finish_ms", "returncode", "timed_out",
    "output_limit_exceeded", "warnings_as_errors",
    "warning_as_error_cli_option", "handoff_state"
  ],
  "properties": {
    "schema_version": {"const": "domain_execution_evidence/v1"},
    "domain": {"enum": ["untrusted_compilation", "trusted_inspection"]},
    "evidence_source": {"enum": ["trusted_host_launcher_and_runtime_inspection/v1", "trusted_wrapper_and_host_launcher/v1"]},
    "invocation_sha256": {"$ref": "#/$defs/sha256"},
    "normalized_executed_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "normalized_executed_argv_sha256": {"$ref": "#/$defs/sha256"},
    "mount_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "effective_sandbox_invocation_v5.schema.json#/$defs/mount"}},
    "runtime_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["oci_runtime_sha256", "oci_runtime_version", "oci_runtime_version_output_sha256"],
      "properties": {
        "oci_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "oci_runtime_version": {"type": "string", "minLength": 1},
        "oci_runtime_version_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requested_controls": {"$ref": "#/$defs/name_set"},
    "emitted_controls": {"$ref": "#/$defs/name_set"},
    "accepted_controls": {"$ref": "#/$defs/name_set"},
    "applied_controls": {"$ref": "#/$defs/name_set"},
    "measured_controls": {"$ref": "#/$defs/name_set"},
    "control_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control_evidence"}},
    "container_uid": {"type": "integer", "minimum": 1},
    "container_gid": {"type": "integer", "minimum": 1},
    "host_directory_uid": {"type": "integer", "minimum": 0},
    "host_directory_gid": {"type": "integer", "minimum": 0},
    "user_namespace_mode": {"const": "keep-id"},
    "domain_file_size_limit": {"type": "integer", "minimum": 1},
    "stdout_bytes_limit": {"type": "integer", "minimum": 1},
    "stderr_bytes_limit": {"type": "integer", "minimum": 1},
    "combined_output_bytes_limit": {"type": "integer", "minimum": 1},
    "request_budget_seconds": {"type": "integer", "minimum": 1},
    "remaining_at_start_ms": {"type": "integer", "minimum": 0},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "remaining_at_finish_ms": {"type": "integer", "minimum": 0},
    "returncode": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "output_limit_exceeded": {"type": "boolean"},
    "warnings_as_errors": {"const": true},
    "warning_as_error_cli_option": {"const": "-DwarningAsError=true"},
    "handoff_state": {"enum": ["compiler_writable", "host_sealed_read_only"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "control_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["control", "status", "source", "observation_sha256"],
      "properties": {
        "control": {"type": "string", "minLength": 1},
        "status": {"enum": ["measured_pass", "measured_fail", "unverified_missing_observation", "derived_pass"]},
        "source": {"type": "string", "minLength": 1},
        "observation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
