{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/kernelState.schema.json",
  "title": "KernelState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kernel_state_id",
    "corpus_manifest_ref",
    "active_rule_set_ref",
    "schema_registry_ref",
    "authority_registry_ref",
    "observer_registry_ref",
    "task_queue_refs",
    "evidence_store_ref",
    "non_collapse_graph_ref",
    "replay_store_ref",
    "policy_engine_ref",
    "audit_log_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "kernel_state/v1"
    },
    "kernel_state_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "active_rule_set_ref": {
      "type": "string",
      "minLength": 1
    },
    "schema_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "observer_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "task_queue_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "evidence_store_ref": {
      "type": "string",
      "minLength": 1
    },
    "non_collapse_graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "replay_store_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_engine_ref": {
      "type": "string",
      "minLength": 1
    },
    "audit_log_ref": {
      "type": "string",
      "minLength": 1
    },
    "safe_mode": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Serializable logical observer kernel state."
}
