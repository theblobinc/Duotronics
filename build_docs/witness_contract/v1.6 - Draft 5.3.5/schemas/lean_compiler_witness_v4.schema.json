{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/lean_compiler_witness_v4.schema.json",
  "title": "Lean Compiler Witness v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lean_compiler_witness_id", "semantic_witness_content_id", "claim_id", "claim_content_sha256", "theorem_statement_sha256", "policy_decision_id", "policy_decision_sha256", "submitted_source_locator", "immutable_snapshot_id", "immutable_snapshot_tree_sha256", "proof_artifact_relative_path", "proof_artifact_sha256", "lakefile_sha256", "lake_manifest_sha256", "lean_toolchain_sha256", "generated_binding_module_sha256", "generated_binding_request_sha256", "generated_binding_module_path", "compiler_profile_id", "compiler_registry_sha256", "verifier_executable_sha256", "lean_executable_sha256", "lake_executable_sha256", "lean_stdlib_tree_sha256", "dependency_closure_sha256", "oci_image_digest", "oci_runtime_sha256", "oci_runtime_version", "oci_runtime_version_output_sha256", "sandbox_policy_sha256", "sandbox_template_sha256", "effective_sandbox_invocation_sha256", "verifier_result_payload_sha256", "verifier_result_signer_key_id", "verifier_result_signed_payload_canonical_json", "verifier_result_signature", "expected_type_expression_hash", "actual_type_expression_hash", "normalization_policy", "axiom_set", "axiom_set_sha256", "direct_dependencies", "transitive_dependencies_root", "forbidden_axiom_set", "sorry_ax_present", "unsafe_dependency_present", "opaque_dependency_policy_result", "build_output_sha256", "stdout_sha256", "stderr_sha256", "output_limit_exceeded", "result", "failure_code", "theorem_name", "theorem_status", "statement_binding_confirmed", "snapshot_verified_immutable", "result_channel_isolated", "requested_controls", "applied_controls", "verified_controls", "authority_snapshot_id", "authority_ledger_high_water_sequence", "verifier_principal_id", "key_id", "signature_algorithm", "trusted_timestamp_source", "created_at", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "lean_compiler_witness/v4"},
    "lean_compiler_witness_id": {"type": "string", "minLength": 1}, "semantic_witness_content_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1}, "claim_content_sha256": {"$ref": "#/$defs/sha256"}, "theorem_statement_sha256": {"$ref": "#/$defs/sha256"},
    "policy_decision_id": {"type": "string", "minLength": 1}, "policy_decision_sha256": {"$ref": "#/$defs/sha256"},
    "submitted_source_locator": {"type": "string", "minLength": 1}, "immutable_snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "immutable_snapshot_tree_sha256": {"$ref": "#/$defs/sha256"}, "proof_artifact_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?!.*\\\\).+[.]lean$"},
    "proof_artifact_sha256": {"$ref": "#/$defs/sha256"}, "lakefile_sha256": {"$ref": "#/$defs/sha256"}, "lake_manifest_sha256": {"$ref": "#/$defs/sha256"}, "lean_toolchain_sha256": {"$ref": "#/$defs/sha256"},
    "generated_binding_module_sha256": {"$ref": "#/$defs/sha256"}, "generated_binding_request_sha256": {"$ref": "#/$defs/sha256"}, "generated_binding_module_path": {"type": "string", "pattern": "^WitnessAuthorityGenerated/Check_[0-9a-f]{32}[.]lean$"},
    "compiler_profile_id": {"type": "string", "minLength": 1}, "compiler_registry_sha256": {"$ref": "#/$defs/sha256"}, "verifier_executable_sha256": {"$ref": "#/$defs/sha256"}, "lean_executable_sha256": {"$ref": "#/$defs/sha256"}, "lake_executable_sha256": {"$ref": "#/$defs/sha256"}, "lean_stdlib_tree_sha256": {"$ref": "#/$defs/sha256"}, "dependency_closure_sha256": {"$ref": "#/$defs/sha256"},
    "oci_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "oci_runtime_sha256": {"$ref": "#/$defs/sha256"}, "oci_runtime_version": {"type": "string", "minLength": 1}, "oci_runtime_version_output_sha256": {"$ref": "#/$defs/sha256"}, "sandbox_policy_sha256": {"$ref": "#/$defs/sha256"}, "sandbox_template_sha256": {"$ref": "#/$defs/sha256"}, "effective_sandbox_invocation_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_result_payload_sha256": {"$ref": "#/$defs/sha256"}, "verifier_result_signer_key_id": {"type": "string", "minLength": 1}, "verifier_result_signed_payload_canonical_json": {"type": "string", "minLength": 2}, "verifier_result_signature": {"type": "string"},
    "expected_type_expression_hash": {"$ref": "#/$defs/sha256"}, "actual_type_expression_hash": {"$ref": "#/$defs/sha256"}, "normalization_policy": {"const": "lean_isDefEq_reducibility_regular/v1"},
    "axiom_set": {"$ref": "#/$defs/name_set"}, "axiom_set_sha256": {"$ref": "#/$defs/sha256"}, "direct_dependencies": {"$ref": "#/$defs/name_set"}, "transitive_dependencies_root": {"$ref": "#/$defs/sha256"}, "forbidden_axiom_set": {"$ref": "#/$defs/name_set"},
    "sorry_ax_present": {"type": "boolean"}, "unsafe_dependency_present": {"type": "boolean"}, "opaque_dependency_policy_result": {"enum": ["passed", "failed", "not_evaluated"]},
    "build_output_sha256": {"$ref": "#/$defs/sha256"}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "output_limit_exceeded": {"type": "boolean"},
    "result": {"enum": ["passed", "failed", "toolchain_unavailable"]}, "failure_code": {"type": ["string", "null"]}, "theorem_name": {"type": "string", "minLength": 1}, "theorem_status": {"enum": ["proved", "failed", "sorry_stub", "axiom_dependent"]},
    "statement_binding_confirmed": {"type": "boolean"}, "snapshot_verified_immutable": {"type": "boolean"}, "result_channel_isolated": {"type": "boolean"},
    "requested_controls": {"$ref": "#/$defs/name_set"}, "applied_controls": {"$ref": "#/$defs/name_set"}, "verified_controls": {"$ref": "#/$defs/name_set"},
    "authority_snapshot_id": {"type": "string", "minLength": 1}, "authority_ledger_high_water_sequence": {"type": "integer", "minimum": 0}, "verifier_principal_id": {"type": "string", "minLength": 1}, "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "Ed25519"}, "trusted_timestamp_source": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "signed_payload_sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "minLength": 43}
  },
  "allOf": [{"if": {"properties": {"result": {"const": "passed"}}}, "then": {"properties": {"failure_code": {"type": "null"}, "theorem_status": {"const": "proved"}, "statement_binding_confirmed": {"const": true}, "snapshot_verified_immutable": {"const": true}, "result_channel_isolated": {"const": true}, "sorry_ax_present": {"const": false}, "unsafe_dependency_present": {"const": false}, "forbidden_axiom_set": {"type": "array", "maxItems": 0}, "output_limit_exceeded": {"const": false}, "opaque_dependency_policy_result": {"const": "passed"}, "verifier_result_signature": {"type": "string", "minLength": 43}}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "name_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
