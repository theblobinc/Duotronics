FROM ghcr.io/leanprover/lean4@sha256:REPLACE_WITH_GOVERNED_LEAN_BUILD_IMAGE_DIGEST AS builder
WORKDIR /src
ENV HOME=/nonexistent LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC SOURCE_DATE_EPOCH=0
COPY lean-toolchain lakefile.lean ./
COPY formal/draft5_3_5/lean formal/draft5_3_5/lean
