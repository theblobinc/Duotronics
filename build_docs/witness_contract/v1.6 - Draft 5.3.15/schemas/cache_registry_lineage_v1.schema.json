{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/cache_registry_lineage_v1.schema.json",
  "title": "Governance-Signed Cache Registry Snapshot Lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "governance_key_id", "current_registry_sha256", "historical_registries", "created_at", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "cache_registry_lineage/v1"},
    "lineage_id": {"$ref": "#/$defs/id"},
    "governance_key_id": {"$ref": "#/$defs/id"},
    "current_registry_sha256": {"$ref": "#/$defs/sha256"},
    "historical_registries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_sha256", "registry_file", "successor_registry_sha256", "stale_replay_policy", "revoked_key_ids"],
        "properties": {
          "registry_sha256": {"$ref": "#/$defs/sha256"},
          "registry_file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
          "successor_registry_sha256": {"$ref": "#/$defs/sha256"},
          "stale_replay_policy": {"const": "authenticate_then_conflict"},
          "revoked_key_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "signature": {"type": "string", "minLength": 43}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
