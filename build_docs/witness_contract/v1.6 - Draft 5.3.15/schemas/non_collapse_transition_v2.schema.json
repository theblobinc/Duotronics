{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/non_collapse_transition_v2.schema.json",
  "title": "NonCollapseTransitionV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "claim_id", "source_primitive_category", "target_primitive_category", "transition_kind", "transition_status", "policy_decision_id", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": "non_collapse_transition/v2"},
    "transition_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "source_primitive_category": {"$ref": "#/$defs/category"},
    "target_primitive_category": {"$ref": "#/$defs/category"},
    "transition_kind": {"enum": ["identity", "measurement", "observation", "promotion", "demotion", "proof_upgrade", "replay_verification", "authority_transfer", "invalid_attempt"]},
    "transition_status": {"enum": ["allowed", "denied", "escalated", "requires_external_witness", "requires_proof_witness"]},
    "external_witness_ref": {"type": ["string", "null"]},
    "proof_witness_id": {"type": ["string", "null"]},
    "policy_decision_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"transition_kind": {"const": "identity"}}, "required": ["transition_kind"]},
      "then": {
        "oneOf": [
          {"properties": {"source_primitive_category": {"const": "zero"}, "target_primitive_category": {"const": "zero"}}},
          {"properties": {"source_primitive_category": {"const": "absence"}, "target_primitive_category": {"const": "absence"}}},
          {"properties": {"source_primitive_category": {"const": "unknown"}, "target_primitive_category": {"const": "unknown"}}},
          {"properties": {"source_primitive_category": {"const": "invalid"}, "target_primitive_category": {"const": "invalid"}}},
          {"properties": {"source_primitive_category": {"const": "empty"}, "target_primitive_category": {"const": "empty"}}},
          {"properties": {"source_primitive_category": {"const": "null"}, "target_primitive_category": {"const": "null"}}},
          {"properties": {"source_primitive_category": {"const": "computational_evidence"}, "target_primitive_category": {"const": "computational_evidence"}}},
          {"properties": {"source_primitive_category": {"const": "theorem"}, "target_primitive_category": {"const": "theorem"}}},
          {"properties": {"source_primitive_category": {"const": "conjectural"}, "target_primitive_category": {"const": "conjectural"}}},
          {"properties": {"source_primitive_category": {"const": "self_trained"}, "target_primitive_category": {"const": "self_trained"}}},
          {"properties": {"source_primitive_category": {"const": "authoritative"}, "target_primitive_category": {"const": "authoritative"}}},
          {"properties": {"source_primitive_category": {"const": "audit_only"}, "target_primitive_category": {"const": "audit_only"}}},
          {"properties": {"source_primitive_category": {"const": "active"}, "target_primitive_category": {"const": "active"}}},
          {"properties": {"source_primitive_category": {"const": "observation"}, "target_primitive_category": {"const": "observation"}}},
          {"properties": {"source_primitive_category": {"const": "proof"}, "target_primitive_category": {"const": "proof"}}},
          {"properties": {"source_primitive_category": {"const": "explanation"}, "target_primitive_category": {"const": "explanation"}}},
          {"properties": {"source_primitive_category": {"const": "fact"}, "target_primitive_category": {"const": "fact"}}},
          {"properties": {"source_primitive_category": {"const": "policy_approval"}, "target_primitive_category": {"const": "policy_approval"}}},
          {"properties": {"source_primitive_category": {"const": "human_attestation"}, "target_primitive_category": {"const": "human_attestation"}}},
          {"properties": {"source_primitive_category": {"const": "synthetic_witness"}, "target_primitive_category": {"const": "synthetic_witness"}}},
          {"properties": {"source_primitive_category": {"const": "activation_witness"}, "target_primitive_category": {"const": "activation_witness"}}}
        ]
      }
    },
    {
      "if": {"properties": {"transition_status": {"const": "allowed"}, "transition_kind": {"const": "proof_upgrade"}}, "required": ["transition_status", "transition_kind"]},
      "then": {
        "properties": {
          "source_primitive_category": {"const": "conjectural"},
          "target_primitive_category": {"const": "theorem"},
          "proof_witness_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "category": {"enum": ["zero", "absence", "unknown", "invalid", "empty", "null", "computational_evidence", "theorem", "conjectural", "self_trained", "authoritative", "audit_only", "active", "observation", "proof", "explanation", "fact", "policy_approval", "human_attestation", "synthetic_witness", "activation_witness"]}
  }
}
