{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duotronics.local/schemas/cache_signing_registry_v1.schema.json",
  "title": "Cache Signing Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "governance_key_id", "created_at", "keys", "signed_payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "cache_signing_registry/v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "governance_key_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "keys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "principal_id", "public_key_base64url", "authorization_scope", "status", "valid_from", "valid_until", "rotation_predecessor_key_id"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "principal_id": {"type": "string", "minLength": 1},
          "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "authorization_scope": {"const": "idempotency_cache_envelope_signing"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "valid_from": {"type": "string", "format": "date-time"},
          "valid_until": {"type": ["string", "null"]},
          "rotation_predecessor_key_id": {"type": ["string", "null"]}
        }
      }
    },
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
