# Duotronic SRNN Open Runtime Example
# Copy to .env. Do not commit real secrets.

APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=sandbox
LOG_LEVEL=info

# PostgreSQL canonical store
POSTGRES_USER=duotronic
POSTGRES_PASSWORD=duotronic_dev_password_change_me
POSTGRES_DB=duotronic_runtime
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://duotronic:duotronic_dev_password_change_me@postgres:5432/duotronic_runtime

# Node identity
SRNN_NODE_ID=local-sandbox
SRNN_NODE_ROLE=coordinator
WG_RNN_LOOPS=1
WG_RNN_STATE_DIM=32
WG_RNN_SLOT_DIM=32
WG_RNN_NUM_SLOTS=64
WG_RNN_RUNTIME_MODE=sandbox

# NLA policy. Keep audit-only by default.
NLA_POLICY_MODE=audit_only
NLA_MIN_COSINE=0.82
NLA_MAX_MSE=0.25
NLA_MIN_REPEAT_STABILITY=0.70
NLA_ALLOW_INFLUENCE_RESPONSE=false
NLA_ALLOW_MEMORY_WRITE=false
NLA_ALLOW_PROMOTE_WITNESS=false

# Optional Milvus
MILVUS_ENABLED=false
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=duotronic_witness_vectors

# Optional Ollama
OLLAMA_ENABLED=false
OLLAMA_HOST=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b

# Optional llama.cpp OpenAI-compatible server
LLAMA_CPP_ENABLED=false
LLAMA_CPP_BASE_URL=http://llama-cpp:8080/v1
LLAMA_CPP_DEFAULT_MODEL=local-gguf
LLAMA_CPP_MODEL=/models/model.gguf

# Corpus mount. Put the corpus ZIP or extracted corpus under ./corpus.
CORPUS_DIR=/runtime/corpus
CORPUS_AUTOINDEX=true

# Storage mounts
RUNTIME_DATA_DIR=/runtime/data
MODEL_REGISTRY_PATH=/runtime/config/models.json

# Security for public demos: set to a random string before exposing beyond localhost.
RUNTIME_API_KEY=

# Runtime host v2 module/corpus control plane
MODULE_REGISTRY_PATH=/runtime/config/modules.json
POLICY_PACK_PATH=/runtime/config/policy_pack.json
FORMAL_OBSERVERS_ENABLED=false

# Optional external services and surfaces
STABLE_DIFFUSION_ENABLED=false
STABLE_DIFFUSION_URL=http://stable-diffusion:7860
TRANSFORMERS_JS_ENABLED=false
TRANSFORMERS_JS_URL=http://transformers-js:8090
LIBRECHAT_ENABLED=false
LIBRECHAT_URL=http://librechat:3080
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=duotronic_minio
MINIO_ROOT_PASSWORD=duotronic_minio_password_change_me

# Model provider timeouts. Ollama cold starts can exceed 60s on CPU/older GPU.
OLLAMA_TIMEOUT_SECONDS=180
LLAMA_CPP_TIMEOUT_SECONDS=180

# Secure HTTP MCP app surface for xavi-runtime.
XAVI_MCP_ENABLED=false
XAVI_MCP_API_KEY=

# Gated repo-edit MCP tools. No push/deploy tools are exposed.
XAVI_MCP_REPO_TOOLS_ENABLED=false
XAVI_REPO_ROOT=/workspace/Duotronics
XAVI_WORKTREE_ROOT=/runtime/data/worktrees
XAVI_REPO_APPROVAL_SECRET=

# Host ops agent for bounded runtime operations through MCP.
XAVI_OPS_ENABLED=false
XAVI_OPS_URL=http://host.containers.internal:8091
XAVI_OPS_API_KEY=
XAVI_OPS_HOST=0.0.0.0
XAVI_OPS_PORT=8091
XAVI_OPS_MAX_OUTPUT=20000

# Optional Fusion Center source credentials
NASA_FIRMS_API_KEY=
CLOUDFLARE_API_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OTX_API_KEY=
GDELT_API_BASE_URL=https://api.gdeltproject.org/api/v2
FUSION_TELEGRAM_SESSION_DIR=/runtime/data/telegram
# Continuous witnessed ingestion of operator-provided training material.
# The runtime mount maps /datastore2/xavi/train read-only to /train.
XAVI_TRAIN_ROOT=/train
XAVI_TRAIN_INGEST_ENABLED=1
XAVI_TRAIN_SCAN_SECONDS=120
XAVI_TRAIN_BACKLOG_SCAN_SECONDS=3
XAVI_TRAIN_SETTLE_SECONDS=30
XAVI_TRAIN_MAX_FILES_PER_SCAN=4
XAVI_TRAIN_PARALLEL_WORKERS=3
# Persistent weighted fair cycle. Missing modalities are automatically appended by the runtime.
XAVI_TRAIN_MODALITY_SCHEDULE=extraction,transcription,extraction,vision,witness

