FROM docker.io/library/python:3.11-slim-bookworm
ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.4.1
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY preload.py /tmp/preload.py
RUN TRANSFORMERS_OFFLINE=0 HF_HUB_OFFLINE=0 python /tmp/preload.py && rm -f /tmp/preload.py
RUN useradd --system --uid 10001 --create-home xavi && mkdir -p /app && chown -R xavi:xavi /app /opt/models
COPY --chown=xavi:xavi app.py /app/app.py
WORKDIR /app
USER 10001
ENV TRANSFORMERS_OFFLINE=1 HF_HUB_OFFLINE=1 XAVI_EMBED_THREADS=32
EXPOSE 8080
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8080","--workers","1","--no-access-log"]
