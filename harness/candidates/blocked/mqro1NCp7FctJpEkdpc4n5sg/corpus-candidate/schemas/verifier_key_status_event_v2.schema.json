{
  "$id": "https://duotronics.local/schemas/verifier_key_status_event_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "replacement_key_id": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "replacement_key_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "effective_time_witness_id": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "timestamp_source": {
            "const": "authority_service_clock"
          }
        },
        "required": [
          "timestamp_source"
        ]
      },
      "then": {
        "properties": {
          "effective_time_witness_id": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "authorization_witness_id": {
      "minLength": 1,
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "type": "string"
    },
    "effective_time_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "governance_key_id": {
      "minLength": 1,
      "type": "string"
    },
    "key_id": {
      "minLength": 1,
      "type": "string"
    },
    "key_status_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "replacement_key_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "verifier_key_status_event/v2"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "pattern": "^[A-Za-z0-9_-]{6170}$",
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "pattern": "^[a-f0-9]{128}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "retired",
        "superseded"
      ]
    },
    "timestamp_source": {
      "enum": [
        "authority_service_clock",
        "trusted_time_witness"
      ]
    }
  },
  "required": [
    "key_status_event_id",
    "schema_version",
    "key_id",
    "status",
    "reason",
    "effective_at",
    "recorded_at",
    "policy_decision_id",
    "authorization_witness_id",
    "governance_key_id",
    "timestamp_source",
    "effective_time_witness_id",
    "signed_payload_shake256_512",
    "signature"
  ],
  "title": "SignedVerifierKeyStatusEventV2",
  "type": "object"
}
