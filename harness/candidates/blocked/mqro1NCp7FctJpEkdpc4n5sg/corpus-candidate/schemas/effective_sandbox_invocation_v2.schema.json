{
  "$defs": {
    "control_set": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "mount": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "pattern": "^/",
          "type": "string"
        },
        "domain": {
          "enum": [
            "untrusted_compilation",
            "trusted_verifier"
          ]
        },
        "lifecycle": {
          "const": "request"
        },
        "mode": {
          "enum": [
            "ro",
            "rw"
          ]
        },
        "purpose": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "mode",
        "domain",
        "purpose",
        "lifecycle"
      ],
      "type": "object"
    },
    "shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/effective_sandbox_invocation_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apparmor_profile": {
      "minLength": 1,
      "type": "string"
    },
    "applied_controls": {
      "$ref": "#/$defs/control_set"
    },
    "arguments": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capability_drop_set": {
      "contains": {
        "const": "ALL"
      },
      "type": "array"
    },
    "container_gid": {
      "minimum": 1,
      "type": "integer"
    },
    "container_uid": {
      "minimum": 1,
      "type": "integer"
    },
    "cpu_limit": {
      "minLength": 1,
      "type": "string"
    },
    "domain": {
      "enum": [
        "untrusted_compilation",
        "trusted_verifier"
      ]
    },
    "entrypoint": {
      "pattern": "^/opt/witness-authority/bin/(compile|verify)-lean$",
      "type": "string"
    },
    "environment_allowlist": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "file_size_limit": {
      "minimum": 1,
      "type": "integer"
    },
    "image_digest": {
      "pattern": "^shake256-512:[0-9a-f]{128}$",
      "type": "string"
    },
    "image_reference": {
      "minLength": 1,
      "type": "string"
    },
    "immutable_policy_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^/",
            "type": "string"
          },
          "shake256_512": {
            "$ref": "#/$defs/shake256_512"
          }
        },
        "required": [
          "path",
          "shake256_512"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "memory_limit": {
      "minLength": 1,
      "type": "string"
    },
    "mount_manifest": {
      "items": {
        "$ref": "#/$defs/mount"
      },
      "minItems": 3,
      "type": "array"
    },
    "network_mode": {
      "const": "none"
    },
    "oci_runtime_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "oci_runtime_version": {
      "minLength": 1,
      "type": "string"
    },
    "oci_runtime_version_output_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "open_file_limit": {
      "minimum": 1,
      "type": "integer"
    },
    "pid_limit": {
      "minimum": 1,
      "type": "integer"
    },
    "read_only_rootfs": {
      "const": true
    },
    "requested_controls": {
      "$ref": "#/$defs/control_set"
    },
    "seccomp_profile_path": {
      "pattern": "^/",
      "type": "string"
    },
    "seccomp_profile_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "security_options": {
      "contains": {
        "const": "no-new-privileges"
      },
      "type": "array"
    },
    "selinux_label": {
      "minLength": 1,
      "type": "string"
    },
    "timeout": {
      "minimum": 1,
      "type": "integer"
    },
    "user_namespace_mode": {
      "minLength": 1,
      "type": "string"
    },
    "working_directory": {
      "const": "/work"
    }
  },
  "required": [
    "domain",
    "oci_runtime_shake256_512",
    "oci_runtime_version",
    "oci_runtime_version_output_shake256_512",
    "image_reference",
    "image_digest",
    "entrypoint",
    "arguments",
    "container_uid",
    "container_gid",
    "network_mode",
    "read_only_rootfs",
    "capability_drop_set",
    "security_options",
    "seccomp_profile_shake256_512",
    "seccomp_profile_path",
    "apparmor_profile",
    "selinux_label",
    "user_namespace_mode",
    "pid_limit",
    "memory_limit",
    "cpu_limit",
    "file_size_limit",
    "open_file_limit",
    "timeout",
    "environment_allowlist",
    "mount_manifest",
    "working_directory",
    "requested_controls",
    "applied_controls",
    "immutable_policy_files"
  ],
  "title": "Effective Sandbox Invocation v2",
  "type": "object"
}
