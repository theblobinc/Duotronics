{
  "$defs": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/cache_stale_row_evidence_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cache_envelope_id": {
      "pattern": "^cache:[0-9a-f]{128}$",
      "type": "string"
    },
    "cache_signer_key_id": {
      "$ref": "#/$defs/id"
    },
    "cache_signer_principal_id": {
      "$ref": "#/$defs/id"
    },
    "current_cache_registry_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "decision": {
      "const": "reject_preserve_row_require_new_idempotency_key"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "historical_registry_id": {
      "$ref": "#/$defs/id"
    },
    "historical_registry_signed_payload_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "historical_replay_policy": {
      "const": "authenticate_then_conflict"
    },
    "reason": {
      "const": "authenticated_cache_signing_registry_replaced_or_rotated"
    },
    "registry_lineage_path": {
      "items": {
        "$ref": "#/$defs/shake256_512"
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "registry_lineage_signed_payload_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    },
    "registry_lineage_verified": {
      "const": true
    },
    "schema_version": {
      "const": "cache_stale_row_evidence/v2"
    },
    "signature_verified": {
      "const": true
    },
    "stored_cache_registry_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    }
  },
  "required": [
    "schema_version",
    "cache_envelope_id",
    "stored_cache_registry_shake256_512",
    "current_cache_registry_shake256_512",
    "historical_registry_id",
    "historical_registry_signed_payload_shake256_512",
    "registry_lineage_signed_payload_shake256_512",
    "cache_signer_key_id",
    "cache_signer_principal_id",
    "signature_verified",
    "registry_lineage_verified",
    "registry_lineage_path",
    "historical_replay_policy",
    "decision",
    "reason",
    "evaluated_at"
  ],
  "title": "Authenticated Historical Cache Stale-Row Evidence v2",
  "type": "object"
}
