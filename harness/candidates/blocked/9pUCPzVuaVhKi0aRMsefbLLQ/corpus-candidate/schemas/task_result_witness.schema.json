{
  "$id": "https://duotronics.local/schemas/taskResultWitness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Final result witness for an observer task.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "kernel_error_witness_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "policy_decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "replay_sign_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "task_result_witness/v1"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "denied",
        "deferred",
        "escalated",
        "rolled_back",
        "inconclusive"
      ]
    },
    "step_witness_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_result_witness_id": {
      "minLength": 1,
      "type": "string"
    },
    "verification_result_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_result_witness_id",
    "task_id",
    "status",
    "step_witness_refs",
    "output_refs",
    "policy_decision_id",
    "created_at"
  ],
  "title": "TaskResultWitness",
  "type": "object"
}
