{
  "$defs": {
    "shake256_512": {
      "pattern": "^[0-9a-f]{128}$",
      "type": "string"
    }
  },
  "$id": "https://duotronics.local/schemas/proof_policy_registry_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "proof_policy_decision_v1.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "governance_key_id": {
      "minLength": 1,
      "type": "string"
    },
    "registry_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "proof_policy_registry/v1"
    },
    "signature": {
      "maxLength": 6170,
      "minLength": 6170,
      "type": "string"
    },
    "signed_payload_shake256_512": {
      "$ref": "#/$defs/shake256_512"
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "governance_key_id",
    "decisions",
    "created_at",
    "signed_payload_shake256_512",
    "signature"
  ],
  "title": "Governance-Signed Proof Policy Registry v1",
  "type": "object"
}
