{
  "schema": "duotronic-witness-harness-vm/v3",
  "domain": "duotronic-witness-harness",
  "libvirt_uri": "qemu:///system",
  "vcpus": 6,
  "memory_mib": 8192,
  "disk_gib": 64,
  "storage_root": "/datastore2/xavi/witness-harness-vm",
  "base_image_policy": "latest-released-ubuntu-server-lts-dynamic",
  "base_image_resolver": "/var/www/xavi/Duotronics/build_docs/runtime/duotronic_srnn_open_runtime-v3/ops_agent/xavi_ubuntu_lts.py",
  "base_image_identity": "SHAKE256-512",
  "guest_user": "harness",
  "guest_harness_root": "/srv/duotronic-harness",
  "guest_run_root": "/srv/duotronic-runs",
  "ssh_private_key": "/var/www/xavi/Duotronics/harness/state/vm/id_rsa",
  "ssh_known_hosts": "/var/www/xavi/Duotronics/harness/state/vm/known_hosts",
  "ssh_ready_timeout_seconds": 240,
  "shutdown_timeout_seconds": 90,
  "auto_shutdown_after_run": true,
  "host_podman_allowed": false,
  "guest_rootless_podman_required": true,
  "production_runtime_network_access": false,
  "production_runtime_activation_enabled": false,
  "sandbox_runtime_enabled": true,
  "sandbox_authority_activation_enabled": true,
  "sandbox_authority_profile": "sandbox-test-only",
  "sandbox_authority_namespace": "duotronic://authority/sandbox/witness-harness-vm",
  "sandbox_production_eligible": false,
  "attestation_signature_suite": "ML-DSA-87",
  "attestation_payload_hash": "SHAKE256-512"
}
